{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workshop-manager-cloudflare",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../public", "binding": "ASSETS" },
  "rules": [{ "type": "Text", "globs": ["views/**/*.ejs"], "fallthrough": true }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "workshop-manager-db",
    "database_id": "17599596-a90d-4555-b81a-1e90a9e0773f",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "workshop-files" }]
}
