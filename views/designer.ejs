<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>المصمم - نظام إدارة الورشة</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"><i class="bi bi-pencil-square"></i> واجهة المصمم</a>
      <span class="navbar-text text-white"><i class="bi bi-person-circle"></i> <%= user.name %></span>
      <div>
        <% if (user.role === 'Admin' || (user.permissions && user.permissions.clients)) { %>
          <a href="/clients" class="btn btn-outline-light btn-sm"><i class="bi bi-people"></i> العملاء</a>
        <% } %>
        <% if (user.role === 'Admin' || (user.permissions && user.permissions.inventory)) { %>
          <a href="/inventory" class="btn btn-outline-light btn-sm"><i class="bi bi-box"></i> المخزون</a>
        <% } %>
        <% if (user.role === 'Admin' || (user.permissions && user.permissions.invoices)) { %>
          <a href="/invoices" class="btn btn-outline-light btn-sm"><i class="bi bi-receipt"></i> الفواتير</a>
        <% } %>
        <a href="/logout" class="btn btn-outline-light btn-sm">خروج</a>
      </div>
    </div>
  </nav>

  <div class="container-fluid mt-3">
    <div class="row">
      <div class="col-md-4">
        <div class="card mb-3">
          <div class="card-header bg-success text-white"><i class="bi bi-plus-circle"></i> طلب جديد</div>
          <div class="card-body">
            <form id="newOrderForm">
              <div class="mb-2">
                <label class="form-label">العميل <span class="text-danger">*</span></label>
                <div class="input-group">
                  <input type="text" id="clientSearch" class="form-control" placeholder="ابحث عن عميل..." autocomplete="off">
                  <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#newClientModal"><i class="bi bi-plus"></i></button>
                </div>
                <select id="clientSelect" class="form-select mt-1" size="5" style="display:none"></select>
                <input type="hidden" id="clientId">
              </div>
              <div class="mb-2">
                <label class="form-label">نوع الماكينة <span class="text-danger">*</span></label>
                <select id="machineType" class="form-select">
                  <option value="Laser">ليزر (Laser)</option>
                  <option value="Router">راوتر (Router)</option>
                </select>
              </div>
              <div class="card bg-light mb-2">
                <div class="card-header p-2 d-flex justify-content-between">
                  <small class="fw-bold"><i class="bi bi-boxes"></i> الخامات المستخدمة</small>
                  <button type="button" class="btn btn-sm btn-success py-0" onclick="addOrderMaterialRow()"><i class="bi bi-plus"></i></button>
                </div>
                <div class="card-body p-2" id="orderMaterials">
                  <div class="row g-1 mb-1 material-row">
                    <div class="col-6">
                      <select class="form-select form-select-sm mat-select"><option value="">-- اختر --</option></select>
                    </div>
                    <div class="col-3">
                      <input type="number" class="form-control form-control-sm mat-qty" placeholder="كمية" step="0.1" min="0">
                    </div>
                    <div class="col-3">
                      <button type="button" class="btn btn-sm btn-outline-danger py-0" onclick="this.closest('.material-row').remove()"><i class="bi bi-x"></i></button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="mb-2">
                <label class="form-label">ملاحظات</label>
                <textarea id="orderNotes" class="form-control" rows="2"></textarea>
              </div>
              <button type="submit" class="btn btn-success w-100"><i class="bi bi-save"></i> إنشاء الطلب</button>
            </form>
          </div>
        </div>
      </div>

      <div class="col-md-8">
        <ul class="nav nav-tabs" id="orderTabs">
          <li class="nav-item"><a class="nav-link active" data-status="all">كل الطلبات</a></li>
          <li class="nav-item"><a class="nav-link" data-status="قيد التصميم">قيد التصميم</a></li>
          <li class="nav-item"><a class="nav-link" data-status="جاهز للقص">جاهز للقص</a></li>
          <li class="nav-item"><a class="nav-link" data-status="قيد التنفيذ">قيد التنفيذ</a></li>
          <li class="nav-item"><a class="nav-link" data-status="تم التسليم">تم التسليم</a></li>
        </ul>
        <div class="card">
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover table-sm">
                <thead>
                  <tr><th>#</th><th>العميل</th><th>الماكينة</th><th>المواد</th><th>ملاحظات</th><th>الحالة</th><th>رفع ملف</th><th>تحميل</th><th>خيارات</th></tr>
                </thead>
                <tbody id="ordersTableBody"></tbody>
              </table>
            </div>
            <nav><ul class="pagination pagination-sm" id="ordersPagination"></ul></nav>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="newClientModal">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header"><h5>عميل جديد</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <div class="mb-2"><label class="form-label">الاسم</label><input type="text" id="newClientName" class="form-control"></div>
          <div class="mb-2"><label class="form-label">رقم الهاتف</label><input type="text" id="newClientPhone" class="form-control"></div>
          <div class="mb-2"><label class="form-label">ملاحظات</label><textarea id="newClientNotes" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-primary" onclick="addClient()">حفظ</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="updateStatusModal">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header"><h5>تحديث حالة الطلب</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <input type="hidden" id="updateTaskId">
          <div class="mb-2"><label class="form-label">الحالة</label>
            <select id="updateStatus" class="form-select">
              <option value="قيد التصميم">قيد التصميم</option>
              <option value="جاهز للقص">جاهز للقص</option>
              <option value="قيد التنفيذ">قيد التنفيذ</option>
              <option value="تم التغليف">تم التغليف</option>
              <option value="تم التسليم">تم التسليم</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-primary" onclick="updateOrderStatus()">تحديث</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="uploadModal">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-primary text-white"><h5><i class="bi bi-upload"></i> رفع ملف التصميم مع تحديد المواد المستهلكة</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <input type="hidden" id="uploadTaskId">
          <div class="mb-3">
            <label class="form-label">ملف التصميم (DXF, CDR, AI, EPS, SVG, PDF, PLT)</label>
            <input type="file" id="uploadFile" class="form-control">
          </div>
          <div class="card bg-light mb-3">
            <div class="card-header d-flex justify-content-between">
              <span><i class="bi bi-boxes"></i> المواد المستهلكة</span>
              <button type="button" class="btn btn-sm btn-success" onclick="addMaterialRow()"><i class="bi bi-plus"></i> إضافة مادة</button>
            </div>
            <div class="card-body" id="materialsContainer">
              <div class="row mb-2 material-row">
                <div class="col-md-5">
                  <select class="form-select mat-select">
                    <option value="">-- اختر المادة --</option>
                  </select>
                </div>
                <div class="col-md-3">
                  <input type="number" class="form-control mat-qty" placeholder="الكمية" step="0.1" min="0">
                </div>
                <div class="col-md-2">
                  <span class="form-text mat-stock"></span>
                </div>
                <div class="col-md-2">
                  <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.material-row').remove()"><i class="bi bi-x"></i></button>
                </div>
              </div>
            </div>
            <div class="card-footer text-muted small">
              <i class="bi bi-info-circle"></i> سيتم خصم المواد تلقائياً من المخزون عند إنجاز الطلب
            </div>
          </div>
          <div class="mb-2">
            <label class="form-label">ملاحظات</label>
            <textarea id="uploadNotes" class="form-control" rows="2" placeholder="ملاحظات إضافية من المصمم..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-primary" onclick="uploadDesignFile()"><i class="bi bi-cloud-upload"></i> رفع الملف مع المواد</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>