<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>إدارة الوكلاء</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body class="agents-page">
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"><i class="bi bi-people"></i> إدارة الوكلاء</a>
      <span class="navbar-text text-white"><i class="bi bi-person-circle"></i> <%= user.name %></span>
      <div>
        <a href="/" class="btn btn-outline-light btn-sm"><i class="bi bi-house"></i> الرئيسية</a>
        <a href="/logout" class="btn btn-outline-light btn-sm ms-2">خروج</a>
      </div>
    </div>
  </nav>

  <div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
      <h3 class="mb-0"><i class="bi bi-people"></i> إدارة الوكلاء</h3>
      <button type="button" class="btn btn-primary" onclick="openAgentModal()">
        <i class="bi bi-person-plus"></i> إضافة وكيل
      </button>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4" id="summaryCards">
      <div class="col-md-3">
        <div class="card bg-primary text-white h-100">
          <div class="card-body text-center">
            <i class="bi bi-people display-6"></i>
            <h5 class="mt-2" id="totalAgents">-</h5>
            <small>إجمالي الوكلاء</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-info text-white h-100">
          <div class="card-body text-center">
            <i class="bi bi-list-task display-6"></i>
            <h5 class="mt-2" id="totalOrders">-</h5>
            <small>طلبات هذا الشهر</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-success text-white h-100">
          <div class="card-body text-center">
            <i class="bi bi-currency-dollar display-6"></i>
            <h5 class="mt-2" id="totalRevenue">-</h5>
            <small>إيرادات هذا الشهر</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-warning text-dark h-100">
          <div class="card-body text-center">
            <i class="bi bi-percent display-6"></i>
            <h5 class="mt-2" id="totalCommission">-</h5>
            <small>عمولات مستحقة</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Filters & Search -->
    <div class="card mb-4">
      <div class="card-body">
        <div class="row g-2 align-items-end">
          <div class="col-md-4">
            <label class="form-label">البحث</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-search"></i></span>
              <input type="text" id="agentSearch" class="form-control" placeholder="بحث بالاسم أو اسم المستخدم..." oninput="debouncedSearch()">
            </div>
          </div>
          <div class="col-md-3">
            <label class="form-label">الحالة</label>
            <select id="statusFilter" class="form-select" onchange="loadAgents()">
              <option value="">الكل</option>
              <option value="active">نشط</option>
              <option value="inactive">معطل</option>
              <option value="suspended">موقوف</option>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label">الترتيب</label>
            <select id="sortFilter" class="form-select" onchange="loadAgents()">
              <option value="newest">الأحدث</option>
              <option value="oldest">الأقدم</option>
              <option value="revenue">الأعلى إيرادات</option>
              <option value="clients">الأكثر عملاء</option>
            </select>
          </div>
          <div class="col-md-3">
            <button class="btn btn-outline-secondary w-100" onclick="exportAgents()"><i class="bi bi-download"></i> تصدير Excel</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Agents Table -->
    <div class="card">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>الوكيل</th>
                <th>الحالة</th>
                <th>العملاء</th>
                <th>الطلبات</th>
                <th>الإيرادات</th>
                <th>العمولة</th>
                <th>بانتظار</th>
                <th>تاريخ الانضمام</th>
                <th>خيارات</th>
              </tr>
            </thead>
            <tbody id="agentsTableBody"></tbody>
          </table>
        </div>
        <div class="card-footer p-3">
          <nav aria-label="Agent pagination">
            <ul class="pagination pagination-sm mb-0 justify-content-center" id="agentsPagination"></ul>
          </nav>
        </div>
      </div>
    </div>
  </div>

  <!-- Add/Edit Agent Modal -->
  <div class="modal fade" id="agentModal">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-dark text-white">
          <h5 class="modal-title" id="modalTitle"><i class="bi bi-person-plus"></i> إضافة وكيل جديد</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <form id="agentForm">
          <div class="modal-body">
            <input type="hidden" id="editAgentId">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">الاسم الكامل <span class="text-danger">*</span></label>
                <input type="text" id="agentName" class="form-control" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">اسم المستخدم <span class="text-danger">*</span></label>
                <input type="text" id="agentUsername" class="form-control" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">كلمة المرور <span class="text-danger">*</span></label>
                <input type="password" id="agentPassword" class="form-control" placeholder="كلمة مرور قوية" required>
              </div>
              <div class="col-md-6">
                <label class="form-label">الهاتف</label>
                <input type="text" id="agentPhone" class="form-control" placeholder="+966...">
              </div>
              <div class="col-md-6">
                <label class="form-label">البريد الإلكتروني</label>
                <input type="email" id="agentEmail" class="form-control">
              </div>
              <div class="col-md-6">
                <label class="form-label">المنطقة/الإقليم</label>
                <input type="text" id="agentTerritory" class="form-control" placeholder="مثال: الرياض، جدة، المنطقة الشرقية">
              </div>
              <div class="col-md-6">
                <label class="form-label">نسبة العمولة الافتراضية (%)</label>
                <input type="number" id="agentCommissionRate" class="form-control" value="10" step="0.1" min="0" max="100">
              </div>
              <div class="col-md-6">
                <label class="form-label">الحساب البنكي</label>
                <input type="text" id="agentBankAccount" class="form-control">
              </div>
              <div class="col-md-6">
                <label class="form-label">الآيبان (IBAN)</label>
                <input type="text" id="agentIBAN" class="form-control" placeholder="SA...">
              </div>
              <div class="col-md-6">
                <label class="form-label">الرقم الضريبي</label>
                <input type="text" id="agentTaxNumber" class="form-control">
              </div>
              <div class="col-md-6">
                <label class="form-label">الحالة</label>
                <select id="agentStatus" class="form-select">
                  <option value="active">نشط</option>
                  <option value="inactive">معطل</option>
                  <option value="suspended">موقوف</option>
                </select>
              </div>
              <div class="col-12">
                <label class="form-label">ملاحظات</label>
                <textarea id="agentNotes" class="form-control" rows="2"></textarea>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/agents.js?v=<%= assetVersion %>"></script>
  <button class="btn-back" title="العودة للخلف" onclick="history.length > 1 ? history.back() : (window.location.href = '/')"><i class="bi bi-arrow-right"></i></button>
</body>
</html>
