<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>إدارة المخزون</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-success">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"><i class="bi bi-box"></i> إدارة المخزون</a>
      <div>
        <a href="/" class="btn btn-outline-light btn-sm">الرئيسية</a>
        <a href="/account" class="btn btn-outline-light btn-sm"><i class="bi bi-person-gear"></i> حسابي</a>
        <a href="/logout" class="btn btn-outline-light btn-sm">خروج</a>
      </div>
    </div>
  </nav>
  <div class="container-fluid mt-3">
    <button id="addInventoryMaterialButton" class="btn btn-success mb-3 d-none" data-bs-toggle="modal" data-bs-target="#inventoryModal"><i class="bi bi-plus"></i> إضافة مادة</button>
    <div class="card">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead><tr><th>#</th><th>اسم المادة</th><th>السماكة</th><th>الكمية</th><th>التكلفة</th><th>خيارات</th></tr></thead>
            <tbody id="inventoryTableBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="inventoryModal">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header"><h5>بيانات المادة</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <input type="hidden" id="editMaterialId">
          <div class="mb-2"><label class="form-label">اسم المادة</label><input type="text" id="materialName" class="form-control"></div>
          <div class="mb-2"><label class="form-label">السماكة</label><input type="text" id="materialThickness" class="form-control" placeholder="مثال: 6mm, 12mm"></div>
          <div class="mb-2"><label class="form-label">الكمية</label><input type="number" id="materialQty" class="form-control" step="0.1"></div>
          <div class="mb-2"><label class="form-label">التكلفة للوحدة</label><input type="number" id="materialCost" class="form-control" step="0.01"></div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-primary" onclick="saveMaterial()">حفظ</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/main.js"></script>
  <script>
    fetch('/api/auth/me')
      .then(response => response.ok ? response.json() : null)
      .then(data => {
        if (data?.user?.Role === 'Admin') document.getElementById('addInventoryMaterialButton').classList.remove('d-none');
      })
      .catch(() => {});
  </script>
<button class="btn-back" title="العودة للخلف" onclick="history.length > 1 ? history.back() : (window.location.href = '/')"><i class="bi bi-arrow-right"></i></button>
</body>
</html>
