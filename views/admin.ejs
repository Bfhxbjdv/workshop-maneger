<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>لوحة التحكم - نظام إدارة الورشة</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .sidebar { min-height: calc(100vh - 56px); background: #f8f9fa; }
    .sidebar .nav-link { color: #333; border-radius: 0; padding: 12px 20px; }
    .sidebar .nav-link:hover { background: #e9ecef; }
    .sidebar .nav-link.active { background: #0d6efd; color: #fff; }
    .sidebar .nav-link i { margin-left: 8px; }
    .tab-content { padding: 20px 0; }
    .stat-card { transition: transform .2s; }
    .stat-card:hover { transform: translateY(-3px); }
    @media print { .sidebar, .navbar, .no-print { display: none !important; } }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"><i class="bi bi-gear-wide"></i> لوحة التحكم</a>
      <span class="navbar-text text-white"><i class="bi bi-person-circle"></i> <%= user.name %></span>
      <div>
        <a href="/" class="btn btn-outline-light btn-sm"><i class="bi bi-house"></i> الرئيسية</a>
        <a href="/account" class="btn btn-outline-light btn-sm"><i class="bi bi-person-gear"></i> حسابي</a>
        <a href="/logout" class="btn btn-outline-light btn-sm">خروج</a>
      </div>
    </div>
  </nav>

  <div class="container-fluid">
    <div class="row">
      <!-- Sidebar -->
      <div class="col-md-2 sidebar p-0">
        <nav class="nav flex-column mt-2">
          <a class="nav-link active" href="#" data-tab="dashboard"><i class="bi bi-speedometer2"></i> الإحصائيات</a>
          <a class="nav-link" href="#" data-tab="expenses"><i class="bi bi-cash-stack"></i> المصروفات</a>
          <a class="nav-link" href="#" data-tab="sync"><i class="bi bi-cloud-arrow-up"></i> مزامنة Drive</a>
          <a class="nav-link" href="#" data-tab="backup"><i class="bi bi-hdd-stack"></i> النسخ الاحتياطي</a>
          <a class="nav-link" href="#" data-tab="logs"><i class="bi bi-journal-text"></i> سجل النشاطات</a>
          <a class="nav-link" href="#" data-tab="system"><i class="bi bi-info-circle"></i> معلومات النظام</a>
          <hr>
          <a class="nav-link" href="#" data-tab="library-images"><i class="bi bi-images"></i> صور المكتبة</a>
          <a class="nav-link" href="#" data-tab="product-pricing"><i class="bi bi-tags"></i> المنتجات والأسعار</a>
          <a class="nav-link" href="#" data-tab="ready-designs"><i class="bi bi-files"></i> التصاميم الجاهزة</a>
          <a class="nav-link" href="#" data-tab="custom-requests"><i class="bi bi-pencil-square"></i> طلبات تصاميم مخصصة</a>
          <a class="nav-link" href="#" data-tab="agent-custom-orders"><i class="bi bi-person-lines-fill"></i> طلبات الوكلاء المخصصة</a>
          <a class="nav-link" href="#" data-tab="pending-approvals"><i class="bi bi-hourglass-split"></i> طلبات بانتظار الموافقة <span class="badge bg-warning text-dark" id="pendingCountBadge" style="display:none">0</span></a>
          <hr>
          <a class="nav-link" href="/users"><i class="bi bi-people"></i> إدارة المستخدمين</a>
          <a class="nav-link" href="/designs"><i class="bi bi-files"></i> ملفات التصاميم</a>
          <a class="nav-link" href="/clients"><i class="bi bi-person-lines-fill"></i> العملاء</a>
          <a class="nav-link" href="/inventory"><i class="bi bi-boxes"></i> المخزون</a>
          <a class="nav-link" href="/invoices"><i class="bi bi-receipt"></i> الفواتير</a>
          <a class="nav-link" href="/expenses"><i class="bi bi-cash"></i> المصروفات (مستقل)</a>
        </nav>
      </div>

      <!-- Main Content -->
      <div class="col-md-10">
        <!-- Dashboard Tab -->
        <div class="tab-content" id="tab-dashboard">
          <h4 class="mb-3"><i class="bi bi-speedometer2"></i> نظرة عامة</h4>
          <div class="row" id="statsCards"></div>
          <div class="card mt-3">
            <div class="card-header"><i class="bi bi-clock-history"></i> آخر النشاطات</div>
            <div class="card-body"><div id="recentLogs"></div></div>
          </div>
        </div>

        <!-- Expenses Tab -->
        <div class="tab-content d-none" id="tab-expenses">
          <div class="d-flex justify-content-between mb-3">
            <h4><i class="bi bi-cash-stack"></i> المصروفات</h4>
            <button class="btn btn-primary btn-sm" onclick="showExpenseModal()"><i class="bi bi-plus"></i> إضافة مصروف</button>
          </div>
          <div class="row mb-3">
            <div class="col-md-4"><div class="card bg-danger text-white p-3 text-center"><h5 id="totalExpenses">0</h5><small>إجمالي المصروفات</small></div></div>
            <div class="col-md-4"><div class="card bg-success text-white p-3 text-center"><h5 id="totalRevenue">0</h5><small>إجمالي الإيرادات</small></div></div>
            <div class="col-md-4"><div class="card bg-info text-white p-3 text-center"><h5 id="netProfit">0</h5><small>صافي الربح</small></div></div>
          </div>
          <input type="text" id="expenseSearch" class="form-control mb-2" placeholder="بحث..." oninput="debounce(loadExpenses,300)()">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead><tr><th>#</th><th>البيان</th><th>التصنيف</th><th>المبلغ</th><th>التاريخ</th><th>ملاحظات</th><th></th></tr></thead>
              <tbody id="expensesTableBody"></tbody>
            </table>
          </div>
          <nav><ul class="pagination pagination-sm" id="expensesPagination"></ul></nav>
        </div>

        <!-- Sync Tab -->
        <div class="tab-content d-none" id="tab-sync">
          <div class="d-flex justify-content-between mb-3">
            <h4><i class="bi bi-cloud-arrow-up"></i> مزامنة Google Drive</h4>
            <div>
              <span id="syncStatus" class="badge bg-secondary me-2"></span>
              <button class="btn btn-primary btn-sm" onclick="syncNow()"><i class="bi bi-arrow-repeat"></i> مزامنة الآن</button>
            </div>
          </div>
          <div class="alert alert-info">عند رفع ملف وعدم وجود إنترنت، يُحفظ محلياً ويُرفع تلقائياً عند توفر الإنترنت.</div>
          <div class="table-responsive">
            <table class="table table-sm">
              <thead><tr><th>#</th><th>الطلب</th><th>الملف</th><th>الحالة</th><th>الخطأ</th><th>التاريخ</th><th></th></tr></thead>
              <tbody id="syncTableBody"></tbody>
            </table>
          </div>
        </div>

        <!-- Backup Tab -->
        <div class="tab-content d-none" id="tab-backup">
          <h4><i class="bi bi-hdd-stack"></i> النسخ الاحتياطي</h4>
          <button class="btn btn-primary mt-2" onclick="createBackup()"><i class="bi bi-database"></i> إنشاء نسخة احتياطية الآن</button>
          <div id="backupResult" class="mt-2"></div>
          <hr>
          <h6>النسخ السابقة</h6>
          <div class="table-responsive">
            <table class="table table-sm">
              <thead><tr><th>الملف</th><th>الحجم</th><th>التاريخ</th></tr></thead>
              <tbody id="backupFilesBody"></tbody>
            </table>
          </div>
        </div>

        <!-- Logs Tab -->
        <div class="tab-content d-none" id="tab-logs">
          <h4><i class="bi bi-journal-text"></i> سجل النشاطات</h4>
          <div class="table-responsive">
            <table class="table table-sm table-hover">
              <thead><tr><th>#</th><th>الإجراء</th><th>المستخدم</th><th>التفاصيل</th><th>التاريخ</th></tr></thead>
              <tbody id="logsTableBody"></tbody>
            </table>
          </div>
          <nav><ul class="pagination pagination-sm" id="logsPagination"></ul></nav>
        </div>

        <!-- System Tab -->
        <div class="tab-content d-none" id="tab-system">
          <h4><i class="bi bi-info-circle"></i> معلومات النظام</h4>
          <div class="row mt-3"><div class="col-md-6"><table class="table table-sm" id="systemInfoTable"></table></div></div>
        </div>

        <!-- Library Images Tab -->
        <div class="tab-content d-none" id="tab-library-images">
          <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h4 class="mb-0"><i class="bi bi-images"></i> صور المكتبة</h4>
            <div class="d-flex gap-2">
              <select id="imageCategoryFilter" class="form-select form-select-sm w-auto" onchange="loadLibraryImages()">
                <option value="">كل التصنيفات</option>
                <option value="عام">عام</option>
                <option value="تصاميم">تصاميم</option>
                <option value="خامات">خامات</option>
                <option value="أخرى">أخرى</option>
                <option value="تصاميم جاهزة">تصاميم جاهزة</option>
                <option value="مراجع عملاء">مراجع عملاء</option>
              </select>
              <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadImageModal"><i class="bi bi-upload"></i> رفع صور</button>
            </div>
          </div>
          <div class="row g-2" id="libraryImagesGrid"></div>
        </div>

        <div class="tab-content d-none" id="tab-product-pricing">
          <div class="row g-3">
            <div class="col-lg-4">
              <div class="card">
                <div class="card-header bg-primary text-white"><i class="bi bi-plus-circle"></i> إضافة منتج وسعره</div>
                <form id="productPricingForm">
                  <div class="card-body">
                    <div class="mb-2"><label class="form-label">اسم المنتج</label><input id="pricingName" class="form-control" required placeholder="مثال: قص ليزر"></div>
                    <div class="mb-2"><label class="form-label">الفئة</label><input id="pricingCategory" class="form-control" placeholder="مثال: قص، حفر"></div>
                    <div class="row g-2"><div class="col-6"><label class="form-label">الوحدة</label><select id="pricingUnit" class="form-select"><option value="لوح">لوح</option><option value="قطعة">قطعة</option></select></div><div class="col-6"><label class="form-label">سعر افتراضي</label><input id="pricingBasePrice" type="number" min="0" step="0.01" class="form-control" value="0"></div></div>
                    <div class="mb-2 mt-2"><label class="form-label">الوصف</label><textarea id="pricingDescription" class="form-control" rows="2"></textarea></div>
                    <label class="form-label fw-bold mt-2">الخامات والأسعار الخاصة بها</label>
                    <div id="pricingMaterials" class="border rounded p-2" style="max-height:260px;overflow:auto"></div>
                    <div class="form-text">اختر خامة واحدة على الأقل وحدد سعر المنتج معها.</div>
                  </div>
                  <div class="card-footer"><button class="btn btn-primary w-100" type="submit">حفظ المنتج</button></div>
                </form>
              </div>
            </div>
            <div class="col-lg-8"><div class="card"><div class="card-header"><i class="bi bi-list-ul"></i> قائمة الأسعار</div><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>المنتج</th><th>الوحدة</th><th>الخامات والأسعار</th><th></th></tr></thead><tbody id="pricingTableBody"></tbody></table></div></div></div></div>
          </div>
        </div>

        <!-- Ready Designs Tab -->
        <div class="tab-content d-none" id="tab-ready-designs">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0"><i class="bi bi-files"></i> التصاميم الجاهزة</h4>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#designModal"><i class="bi bi-plus"></i> إضافة تصميم</button>
          </div>
          <div class="card">
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover mb-0">
                  <thead class="table-light">
                    <tr><th>#</th><th>الاسم</th><th>الفئة</th><th>المادة</th><th>السمك</th><th>الأبعاد</th><th>الصور</th><th>الحالة</th><th>خيارات</th></tr>
                  </thead>
                  <tbody id="designsTableBody"></tbody>
                </table>
              </div>
              <div class="card-footer p-3">
                <nav><ul class="pagination pagination-sm mb-0 justify-content-center" id="designsPagination"></ul></nav>
              </div>
            </div>
          </div>
        </div>

        <!-- Custom Requests Tab -->
        <div class="tab-content d-none" id="tab-custom-requests">
          <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> طلبات تصاميم مخصصة</h4>
            <div class="d-flex gap-2">
              <select id="customStatusFilter" class="form-select form-select-sm w-auto" onchange="loadCustomRequests()">
                <option value="">كل الحالات</option>
                <option value="pending">جديد</option>
                <option value="in_progress">قيد التنفيذ</option>
                <option value="completed">مكتمل</option>
                <option value="cancelled">ملغي</option>
              </select>
              <input type="text" id="customSearch" class="form-control form-control-sm" style="width:250px" placeholder="بحث..." oninput="debounceCustomSearch()">
            </div>
          </div>
          <div class="card">
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover mb-0">
                  <thead class="table-light">
                    <tr><th>#</th><th>الوكيل</th><th>العميل</th><th>اسم التصميم</th><th>الوصف</th><th>الحالة</th><th>المصمم</th><th>التاريخ</th><th>خيارات</th></tr>
                  </thead>
                  <tbody id="customRequestsTableBody"></tbody>
                </table>
              </div>
              <div class="card-footer p-3">
                <nav><ul class="pagination pagination-sm mb-0 justify-content-center" id="customPagination"></ul></nav>
              </div>
            </div>
          </div>
        </div>

        <!-- Agent Custom Orders Tab -->
        <div class="tab-content d-none" id="tab-agent-custom-orders">
          <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h4 class="mb-0"><i class="bi bi-person-lines-fill"></i> طلبات الوكلاء المخصصة</h4>
            <button class="btn btn-outline-secondary" onclick="exportAgentCustomOrders()"><i class="bi bi-download"></i> تصدير</button>
          </div>
          <div class="card">
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover mb-0">
                  <thead class="table-light">
                    <tr><th>#</th><th>الوكيل</th><th>العميل</th><th>الطلب</th><th>الملفات</th><th>التاريخ</th><th>خيارات</th></tr>
                  </thead>
                  <tbody id="agentCustomOrdersTableBody"></tbody>
                </table>
              </div>
              <div class="card-footer p-3">
                <nav><ul class="pagination pagination-sm mb-0 justify-content-center" id="agentCustomPagination"></ul></nav>
              </div>
            </div>
          </div>
        </div>
        <!-- Pending Approvals Tab -->
        <div class="tab-content d-none" id="tab-pending-approvals">
          <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h4 class="mb-0"><i class="bi bi-hourglass-split"></i> طلبات الوكلاء بانتظار الموافقة</h4>
            <button class="btn btn-outline-secondary btn-sm" onclick="loadPendingApprovals()"><i class="bi bi-arrow-repeat"></i> تحديث</button>
          </div>
          <div class="alert alert-info small">الموافقة تُسند الطلب تلقائياً للمصمم المختار ويظهر عنده فوراً كطلب عادي. الرفض يلغي الطلب مع إشعار الوكيل.</div>
          <div class="card">
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover mb-0">
                  <thead class="table-light">
                    <tr><th>#</th><th>الوكيل</th><th>العميل</th><th>الماكينة</th><th>الكمية (لوح)</th><th>السعر النهائي</th><th>ملاحظات</th><th>التاريخ</th><th>خيارات</th></tr>
                  </thead>
                  <tbody id="pendingApprovalsTableBody"></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
  <!-- Design Modal -->
  <div class="modal fade" id="designModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-primary text-white"><h5><i class="bi bi-plus"></i> إضافة/تعديل تصميم</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
        <form id="designForm">
          <div class="modal-body">
            <input type="hidden" id="designId">
            <div class="row g-2">
              <div class="col-md-6"><label class="form-label">الاسم <span class="text-danger">*</span></label><input type="text" id="designName" class="form-control" required></div>
              <div class="col-md-6"><label class="form-label">الفئة</label><input type="text" id="designCategory" class="form-control" placeholder="مثال: ديكور، أثاث، شعارات"></div>
              <div class="col-md-6"><label class="form-label">المادة</label><input type="text" id="designMaterial" class="form-control" placeholder="مثال: خشب، معدن، بلاستيك"></div>
              <div class="col-md-6"><label class="form-label">السمك</label><input type="text" id="designThickness" class="form-control" placeholder="مثال: 3مم، 5مم"></div>
              <div class="col-md-6"><label class="form-label">العرض</label><input type="number" id="designWidth" class="form-control" step="0.1" placeholder="العرض بالمم"></div>
              <div class="col-md-6"><label class="form-label">الارتفاع</label><input type="number" id="designHeight" class="form-control" step="0.1" placeholder="الارتفاع بالمم"></div>
              <div class="col-md-6"><label class="form-label">الوحدة</label><input type="text" id="designUnit" class="form-control" value="مم"></div>
              <div class="col-12"><label class="form-label">الوصف</label><textarea id="designNotes" class="form-control" rows="2"></textarea></div>
              <div class="col-md-6"><label class="form-label">ملف التصميم <span class="text-danger">*</span></label><input type="text" id="designFilePath" class="form-control" placeholder="مسار الملف في التخزين" required></div>
              <div class="col-md-6"><label class="form-label">الاسم الأصلي للملف</label><input type="text" id="designOriginalName" class="form-control"></div>
              <div class="col-md-6"><label class="form-label">مسار الصورة المصغرة</label><input type="text" id="designThumbnail" class="form-control"></div>
              <div class="col-md-6"><label class="form-label">كلمة مرور (اختياري)</label><input type="password" id="designPassword" class="form-control"></div>
            </div>
          </div>
          <div class="modal-footer">
            <button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Upload Image Modal -->
  <div class="modal fade" id="uploadImageModal">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header bg-success text-white"><h5><i class="bi bi-upload"></i> رفع صور</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
        <form id="uploadImageForm" enctype="multipart/form-data">
          <div class="modal-body">
            <div class="mb-2">
              <label class="form-label">التصنيف</label>
              <select id="uploadImageCategory" name="category" class="form-select">
                <option value="عام">عام</option>
                <option value="تصاميم">تصاميم</option>
                <option value="خامات">خامات</option>
                <option value="أخرى">أخرى</option>
                <option value="تصاميم جاهزة">تصاميم جاهزة</option>
                <option value="مراجع عملاء">مراجع عملاء</option>
              </select>
            </div>
            <div class="mb-2">
              <label class="form-label">الصور (يمكن اختيار عدة ملفات)</label>
              <input type="file" id="uploadImageFiles" name="images" class="form-control" accept=".png,.jpg,.jpeg,.gif,.webp,.bmp,.svg,.avif,.ico" multiple required>
              <div class="form-text">حتى 50 صورة، بحد أقصى 10 ميغابايت للصورة.</div>
              <div id="uploadImagePreviews" class="row g-2 mt-2" aria-live="polite"></div>
            </div>
          </div>
          <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
          <button type="button" id="uploadAdminImagesButton" class="btn btn-success"><i class="bi bi-cloud-upload"></i> رفع</button>
          </div>
        </form>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="imageMaterialsModal" tabindex="-1" aria-labelledby="imageMaterialsTitle" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 id="imageMaterialsTitle">خامات الصورة</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p class="small text-muted">إذا لم تحدد خامة، تظل الصورة متاحة مع كل خامات المنتج. اختر الخامات لتقييدها.</p><input type="hidden" id="imageMaterialsImageId"><div id="imageMaterialsList"></div></div><div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button><button type="button" class="btn btn-primary" onclick="saveImageMaterials()">حفظ الخامات</button></div></div></div>
  </div>

  <!-- Approve Custom Request Modal -->
  <div class="modal fade" id="approveCustomModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header bg-success text-white"><h5><i class="bi bi-check-lg"></i> الموافقة وبدء التنفيذ</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
        <form id="approveCustomForm">
          <div class="modal-body">
            <input type="hidden" id="approveCustomId">
            <div class="mb-2">
              <label class="form-label">المصمم الذي سيستلم الطلب <span class="text-danger">*</span></label>
              <select id="approveDesignerSelect" class="form-select" required>
                <option value="">-- اختر المصمم --</option>
              </select>
            </div>
            <div id="approveOrderFields" style="display:none;">
              <div class="alert alert-info small">هذا الطلب غير مرتبط بطلب — سيتم إنشاء طلب حقيقي يظهر للرسام فور الموافقة.</div>
              <div class="mb-2">
                <label class="form-label">العميل <span class="text-danger">*</span></label>
                <select id="approveClientSelect" class="form-select">
                  <option value="">-- اختر العميل --</option>
                </select>
              </div>
              <div class="mb-2">
                <label class="form-label">نوع الماكينة <span class="text-danger">*</span></label>
                <select id="approveMachineSelect" class="form-select">
                  <option value="Laser">ليزر (Laser)</option>
                  <option value="Router">راوتر (Router)</option>
                </select>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
            <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> موافقة وبدء التنفيذ</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Approve Order Modal (agent pending orders) -->
  <div class="modal fade" id="approveOrderModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header bg-success text-white"><h5 id="approveOrderTitle"><i class="bi bi-check-lg"></i> الموافقة على الطلب</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
        <form id="approveOrderForm">
          <div class="modal-body">
            <input type="hidden" id="approveOrderId">
            <div class="alert alert-info small">سيُسند الطلب للمصمم المختار ويظهر عنده فوراً كطلب عادي.</div>
            <div class="mb-2">
              <label class="form-label">المصمم الذي سيستلم الطلب <span class="text-danger">*</span></label>
              <select id="approveOrderDesigner" class="form-select" required>
                <option value="">-- اختر المصمم --</option>
              </select>
            </div>
          </div>
          <div class="modal-footer">
            <button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
            <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> موافقة</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal fade" id="expenseModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header bg-primary text-white">
          <h5><i class="bi bi-cash-stack"></i> إضافة مصروف</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="expenseId">
          <div class="mb-2"><label class="form-label">البيان</label><input type="text" id="expenseDesc" class="form-control"></div>
          <div class="mb-2"><label class="form-label">التصنيف</label><select id="expenseCat" class="form-select"><option value="أخرى">أخرى</option><option value="مواد">مواد</option><option value="رواتب">رواتب</option><option value="صيانة">صيانة</option><option value="نقل">نقل</option></select></div>
          <div class="mb-2"><label class="form-label">المبلغ</label><input type="number" id="expenseAmount" class="form-control" min="0" step="0.01"></div>
          <div class="mb-2"><label class="form-label">التاريخ</label><input type="date" id="expenseDate" class="form-control"></div>
          <div class="mb-2"><label class="form-label">ملاحظات</label><textarea id="expenseNotes" class="form-control" rows="2"></textarea></div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
          <button class="btn btn-primary" onclick="saveExpense()"><i class="bi bi-check-lg"></i> حفظ</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/main.js"></script>
  <script>
    // Tab switching
    document.querySelectorAll('[data-tab]').forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        document.querySelectorAll('[data-tab]').forEach(l => l.classList.remove('active'));
        this.classList.add('active');
        document.querySelectorAll('.tab-content').forEach(t => t.classList.add('d-none'));
        document.getElementById('tab-' + this.dataset.tab).classList.remove('d-none');

        // Load data per tab
        const tab = this.dataset.tab;
        if (tab === 'dashboard') loadAdminStats();
        if (tab === 'expenses') loadExpenses();
        if (tab === 'sync') loadSyncQueue();
        if (tab === 'backup') loadBackups();
        if (tab === 'logs') loadLogs();
        if (tab === 'system') loadSystemInfo();
      });
    });

    // ============ ADMIN STATS ============
    async function loadAdminStats() {
      const d = await fetch('/admin/api/admin-stats').then(r => r.json());
      document.getElementById('statsCards').innerHTML = `
        <div class="col-md-3 mb-2"><div class="card stat-card bg-primary text-white p-3 text-center"><h3>${d.totalUsers}</h3><small>المستخدمين</small></div></div>
        <div class="col-md-3 mb-2"><div class="card stat-card bg-success text-white p-3 text-center"><h3>${d.totalClients}</h3><small>العملاء</small></div></div>
        <div class="col-md-3 mb-2"><div class="card stat-card bg-info text-white p-3 text-center"><h3>${d.totalOrders}</h3><small>الطلبات</small></div></div>
        <div class="col-md-3 mb-2"><div class="card stat-card bg-warning text-dark p-3 text-center"><h3>${d.totalInvoices}</h3><small>الفواتير</small></div></div>
        <div class="col-md-3 mb-2"><div class="card stat-card bg-danger text-white p-3 text-center"><h3>${parseFloat(d.totalExpenses).toFixed(2)}</h3><small>إجمالي المصروفات</small></div></div>
        <div class="col-md-3 mb-2"><div class="card stat-card bg-success text-white p-3 text-center"><h3>${parseFloat(d.totalRevenue).toFixed(2)}</h3><small>إجمالي الإيرادات</small></div></div>
        <div class="col-md-3 mb-2"><div class="card stat-card ${(d.totalRevenue - d.totalExpenses) >= 0 ? 'bg-primary' : 'bg-danger'} text-white p-3 text-center"><h3>${parseFloat(d.totalRevenue - d.totalExpenses).toFixed(2)}</h3><small>صافي الربح</small></div></div>
        <div class="col-md-3 mb-2"><div class="card stat-card bg-secondary text-white p-3 text-center"><h3>${d.pendingUploads}</h3><small>بانتظار الرفع</small></div></div>
      `;

      document.getElementById('recentLogs').innerHTML = d.recentLogs.length
        ? '<div class="table-responsive"><table class="table table-sm"><tr><th>الإجراء</th><th>المستخدم</th><th>التفاصيل</th><th>التاريخ</th></tr>' +
          d.recentLogs.map(l => `<tr><td>${l.Action}</td><td>${l.User_Name || '-'}</td><td>${l.Details || ''}</td><td><small>${l.Created_At}</small></td></tr>`).join('') + '</table></div>'
        : '<div class="text-muted">لا توجد نشاطات بعد</div>';
    }

    // ============ EXPENSES ============
    let expPage = 1;
    async function loadExpenses(page) {
      if (page) expPage = page;
      const search = document.getElementById('expenseSearch')?.value || '';
      const d = await fetch(`/admin/api/expenses?page=${expPage}&search=${encodeURIComponent(search)}`).then(r => r.json());
      const tbody = document.getElementById('expensesTableBody');
      if (!tbody) return;
      tbody.innerHTML = !d.expenses?.length ? '<tr><td colspan="7" class="text-center">لا توجد مصروفات</td></tr>'
        : d.expenses.map(e => `<tr>
          <td>${e.Expense_ID}</td><td>${e.Description}</td>
          <td><span class="badge bg-secondary">${e.Category}</span></td>
          <td>${parseFloat(e.Amount).toFixed(2)}</td>
          <td>${e.Expense_Date}</td>
          <td><small>${e.Notes || ''}</small></td>
          <td>
            <button class="btn btn-sm btn-outline-danger" onclick="deleteExpense(${e.Expense_ID})"><i class="bi bi-trash"></i></button>
          </td>
        </tr>`).join('');
      renderPagination2('expensesPagination', d.page, d.pages, loadExpenses);

      // Update totals
      const stats = await fetch('/admin/api/admin-stats').then(r => r.json());
      document.getElementById('totalExpenses').textContent = parseFloat(stats.totalExpenses).toFixed(2);
      document.getElementById('totalRevenue').textContent = parseFloat(stats.totalRevenue).toFixed(2);
      document.getElementById('netProfit').textContent = parseFloat(stats.totalRevenue - stats.totalExpenses).toFixed(2);
    }

    function showExpenseModal() {
      document.getElementById('expenseId').value = '';
      document.getElementById('expenseDesc').value = '';
      document.getElementById('expenseCat').value = 'أخرى';
      document.getElementById('expenseAmount').value = '';
      document.getElementById('expenseDate').value = new Date().toISOString().split('T')[0];
      document.getElementById('expenseNotes').value = '';
      new bootstrap.Modal(document.getElementById('expenseModal')).show();
    }

    async function saveExpense() {
      const desc = document.getElementById('expenseDesc').value;
      const amount = document.getElementById('expenseAmount').value;
      if (!desc || !amount) { showToast('البيان والمبلغ مطلوبان', 'warning'); return; }
      const r = await fetch('/admin/api/expenses', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({
          Description: desc, Category: document.getElementById('expenseCat').value,
          Amount: amount, Expense_Date: document.getElementById('expenseDate').value,
          Notes: document.getElementById('expenseNotes').value
        })
      }).then(r => r.json());
      if (r.error) { showToast(r.error, 'danger'); return; }
      showToast('تم إضافة المصروف', 'success');
      bootstrap.Modal.getInstance(document.getElementById('expenseModal')).hide();
      loadExpenses();
    }

    async function deleteExpense(id) {
      if (!confirm('حذف هذا المصروف؟')) return;
      await fetch(`/admin/api/expenses/${id}`, { method: 'DELETE' });
      showToast('تم الحذف', 'success');
      loadExpenses();
    }

    // ============ SYNC QUEUE ============
    async function loadSyncQueue() {
      const items = await fetch('/admin/api/upload-queue').then(r => r.json());
      const statusColors = { 'pending': 'warning', 'uploading': 'info', 'done': 'success', 'failed': 'danger' };
      const pending = items.filter(i => i.Status === 'pending').length;
      document.getElementById('syncStatus').textContent = `${pending} ملف بانتظار الرفع`;
      document.getElementById('syncStatus').className = `badge bg-${pending > 0 ? 'warning' : 'success'} me-2`;
      document.getElementById('syncTableBody').innerHTML = items.length === 0
        ? '<tr><td colspan="7" class="text-center text-muted">لا توجد ملفات في قائمة الانتظار</td></tr>'
        : items.map(i => `<tr>
          <td>${i.Queue_ID}</td><td>#${i.Task_ID}</td>
          <td><small>${i.Original_Name}</small></td>
          <td><span class="badge bg-${statusColors[i.Status]}">${i.Status === 'pending' ? 'بانتظار الرفع' : i.Status === 'uploading' ? 'جاري الرفع' : i.Status === 'done' ? 'تم' : 'فشل'}</span></td>
          <td><small class="text-danger">${i.Error || ''}</small></td>
          <td><small>${i.Created_At}</small></td>
          <td>${i.Status === 'failed' ? `<button class="btn btn-sm btn-outline-warning" onclick="retrySync(${i.Queue_ID})"><i class="bi bi-arrow-repeat"></i></button>` : ''}</td>
        </tr>`).join('');
    }

    async function retrySync(id) {
      await fetch(`/admin/api/upload-queue/retry/${id}`, { method: 'POST' });
      showToast('سيتم إعادة المحاولة', 'info');
      loadSyncQueue();
    }

    async function syncNow() {
      const btn = event.target;
      btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> جاري...';
      const r = await fetch('/admin/api/sync-now', { method: 'POST' }).then(r => r.json());
      showToast(`تمت المزامنة: ${r.synced} نجاح, ${r.failed} فشل`, r.failed > 0 ? 'warning' : 'success');
      btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-repeat"></i> مزامنة الآن';
      loadSyncQueue();
    }

    // ============ BACKUP ============
    async function createBackup() {
      const btn = event.target; btn.disabled = true;
      const r = await fetch('/admin/api/backup', { method: 'POST' }).then(r => r.json());
      if (r.error) { showToast(r.error, 'danger'); } else { showToast('تم إنشاء النسخة الاحتياطية', 'success'); }
      btn.disabled = false;
      loadBackups();
    }

    async function loadBackups() {
      const files = await fetch('/admin/api/backups').then(r => r.json());
      document.getElementById('backupFilesBody').innerHTML = files.length === 0
        ? '<tr><td colspan="3" class="text-muted">لا توجد نسخ احتياطية</td></tr>'
        : files.map(f => `<tr><td>${f.name}</td><td>${(f.size / 1024).toFixed(1)} KB</td><td>${new Date(f.date).toLocaleString()}</td></tr>`).join('');
    }

    // ============ LOGS ============
    let logsPage = 1;
    async function loadLogs(page) {
      if (page) logsPage = page;
      const d = await fetch(`/admin/api/logs?page=${logsPage}`).then(r => r.json());
      document.getElementById('logsTableBody').innerHTML = !d.logs?.length
        ? '<tr><td colspan="5" class="text-muted">لا توجد نشاطات</td></tr>'
        : d.logs.map(l => `<tr><td>${l.Log_ID}</td><td>${l.Action}</td><td>${l.User_Name || '-'}</td><td><small>${l.Details || ''}</small></td><td><small>${l.Created_At}</small></td></tr>`).join('');
      renderPagination2('logsPagination', d.page, d.pages, loadLogs);
    }

    // ============ SYSTEM INFO ============
    async function loadSystemInfo() {
      const info = await fetch('/admin/api/system-info').then(r => r.json());
      document.getElementById('systemInfoTable').innerHTML = `
        <tr><td>Node.js</td><td>${info.nodeVersion}</td></tr>
        <tr><td>المنصة</td><td>${info.platform}</td></tr>
        <tr><td>مدة التشغيل</td><td>${Math.floor(info.uptime / 60)} دقيقة</td></tr>
        <tr><td>الذاكرة المستخدمة</td><td>${(info.memoryUsage?.heapUsed / 1024 / 1024).toFixed(1)} MB</td></tr>
        <tr><td>حجم قاعدة البيانات</td><td>${(info.dbSize / 1024).toFixed(1)} KB</td></tr>
        <tr><td>حجم التخزين</td><td>${(info.storageSize / 1024 / 1024).toFixed(1)} MB</td></tr>
        <tr><td>Google Drive</td><td>${info.driveConfigured ? '<span class="text-success">✔ مهيأ</span>' : '<span class="text-danger">✘ غير مهيأ</span>'}</td></tr>
      `;
    }

    // Pagination helper
    function renderPagination2(el, page, total, fn) {
      const ul = document.getElementById(el);
      if (!ul) return;
      ul.innerHTML = '';
      if (total <= 1) return;
      for (let i = 1; i <= total; i++) {
        const li = document.createElement('li');
        li.className = `page-item ${i === page ? 'active' : ''}`;
        li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
        li.addEventListener('click', e => { e.preventDefault(); fn(i); });
        ul.appendChild(li);
      }
    }

    // ============ LIBRARY IMAGES ============
    let imagePage = 1;
    async function loadLibraryImages(page) {
      if (page) imagePage = page;
      const category = document.getElementById('imageCategoryFilter').value;
      const params = new URLSearchParams({ page: imagePage, limit: 20 });
      if (category) params.append('category', category);
      const d = await fetch('/api/orders/agent/images?' + params.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json());
      renderLibraryImages(d.images || []);
    }

    function escapeImageText(value) {
      return String(value || '').replace(/[&<>"']/g, c => ({'&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'}[c]));
    }

    let adminMaterials = [];
    async function loadProductPricing() {
      const [pricingResponse, materialsResponse] = await Promise.all([
        fetch('/api/orders/pricing', { headers: { 'X-Requested-With': 'XMLHttpRequest' } }),
        fetch('/api/inventory', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      ]);
      const pricingData = await pricingResponse.json();
      adminMaterials = await materialsResponse.json();
      renderPricingMaterials();
      const body = document.getElementById('pricingTableBody');
      body.innerHTML = (pricingData.pricing || []).length ? (pricingData.pricing || []).map(product => `
        <tr><td><strong>${escapeImageText(product.Product_Name)}</strong><small class="d-block text-muted">${escapeImageText(product.Category || '')}</small></td>
        <td>${escapeImageText(product.Unit)}</td>
        <td>${(product.Materials || []).length ? product.Materials.map(material => `${escapeImageText(material.Material_Name)} ${material.Thickness ? `(${escapeImageText(material.Thickness)})` : ''}: <strong>${Number(material.Price).toLocaleString()}</strong>`).join('<br>') : `<span class="text-muted">السعر الافتراضي: ${Number(product.Base_Price).toLocaleString()}</span>`}</td>
        <td><button class="btn btn-sm btn-outline-danger" onclick="deleteProductPricing(${product.Pricing_ID})">حذف</button></td></tr>`).join('') : '<tr><td colspan="4" class="text-center text-muted py-4">لا توجد منتجات بعد</td></tr>';
    }
    function renderPricingMaterials() {
      const target = document.getElementById('pricingMaterials');
      target.innerHTML = adminMaterials.length ? adminMaterials.map(material => `<div class="row g-1 align-items-center mb-1"><div class="col-7 form-check"><input class="form-check-input pricing-material-check" type="checkbox" value="${material.Material_ID}" id="pricingMaterial${material.Material_ID}"><label class="form-check-label" for="pricingMaterial${material.Material_ID}">${escapeImageText(material.Material_Name)} ${material.Thickness ? `(${escapeImageText(material.Thickness)})` : ''}</label></div><div class="col-5"><input type="number" class="form-control form-control-sm pricing-material-price" data-material-id="${material.Material_ID}" min="0" step="0.01" placeholder="السعر" disabled></div></div>`).join('') : '<div class="text-muted small">أضف الخامات من صفحة المخزون أولاً.</div>';
      target.querySelectorAll('.pricing-material-check').forEach(check => check.addEventListener('change', event => {
        target.querySelector(`.pricing-material-price[data-material-id="${event.target.value}"]`).disabled = !event.target.checked;
      }));
    }
    async function saveProductPricing(event) {
      event.preventDefault();
      const rows = [...document.querySelectorAll('.pricing-material-check:checked')].map(check => ({
        Material_ID: Number(check.value), Price: Number(document.querySelector(`.pricing-material-price[data-material-id="${check.value}"]`).value)
      }));
      if (!rows.length || rows.some(row => !Number.isFinite(row.Price) || row.Price < 0)) return alert('اختر خامة واحدة على الأقل وحدد سعرًا صحيحًا لها');
      const response = await fetch('/api/orders/pricing', { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify({
        Product_Name: document.getElementById('pricingName').value.trim(), Category: document.getElementById('pricingCategory').value.trim(), Unit: document.getElementById('pricingUnit').value,
        Base_Price: Number(document.getElementById('pricingBasePrice').value) || 0, Description: document.getElementById('pricingDescription').value.trim(), Material_Prices: rows
      }) });
      const data = await response.json();
      if (!response.ok) return alert(data.error || 'تعذر حفظ المنتج');
      document.getElementById('productPricingForm').reset();
      await loadProductPricing();
    }
    async function deleteProductPricing(id) {
      if (!confirm('حذف هذا المنتج وأسعاره؟')) return;
      const response = await fetch(`/api/orders/pricing/${id}`, { method: 'DELETE', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      const data = await response.json();
      if (!response.ok) return alert(data.error || 'تعذر الحذف');
      loadProductPricing();
    }
    async function openImageMaterials(id) {
      if (!adminMaterials.length) adminMaterials = await fetch('/api/inventory', { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json());
      const data = await fetch(`/api/orders/agent/images/${id}/materials`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json());
      const selected = new Set((data.materials || []).map(material => Number(material.Material_ID)));
      document.getElementById('imageMaterialsImageId').value = id;
      document.getElementById('imageMaterialsList').innerHTML = adminMaterials.length ? adminMaterials.map(material => `<div class="form-check"><input class="form-check-input image-material-check" type="checkbox" value="${material.Material_ID}" id="imageMaterial${material.Material_ID}" ${selected.has(Number(material.Material_ID)) ? 'checked' : ''}><label class="form-check-label" for="imageMaterial${material.Material_ID}">${escapeImageText(material.Material_Name)} ${material.Thickness ? `(${escapeImageText(material.Thickness)})` : ''}</label></div>`).join('') : '<div class="text-muted">لا توجد خامات في المخزون.</div>';
      bootstrap.Modal.getOrCreateInstance(document.getElementById('imageMaterialsModal')).show();
    }
    async function saveImageMaterials() {
      const id = document.getElementById('imageMaterialsImageId').value;
      const Material_IDs = [...document.querySelectorAll('.image-material-check:checked')].map(input => Number(input.value));
      const response = await fetch(`/api/orders/agent/images/${id}/materials`, { method: 'PUT', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify({ Material_IDs }) });
      const data = await response.json();
      if (!response.ok) return alert(data.error || 'تعذر حفظ الخامات');
      bootstrap.Modal.getOrCreateInstance(document.getElementById('imageMaterialsModal')).hide();
      loadLibraryImages();
    }

    function renderLibraryImages(images) {
      const grid = document.getElementById('libraryImagesGrid');
      if (!images.length) {
        grid.innerHTML = '<div class="col-12 text-center text-muted py-4">لا توجد صور. اضغط "رفع صور" لإضافة صور.</div>';
        return;
      }
      grid.innerHTML = '';
      images.forEach(img => {
        const col = document.createElement('div');
        col.className = 'col-6 col-md-4 col-lg-3';
        const hasDesign = img.Design_ID ? `<span class="badge bg-success">مرتبط بتصميم: ${escapeImageText(img.Design_Name)}</span>` : '<span class="badge bg-secondary">مكتبة مستقلة</span>';
        col.innerHTML = `
          <div class="card h-100">
            <img src="/api/orders/agent/images/${img.Image_ID}/file" alt="${escapeImageText(img.Original_Name)}" class="card-img-top bg-light" style="height:180px;object-fit:contain" onerror="this.classList.add('d-none'); this.nextElementSibling.classList.remove('d-none')">
            <div class="d-none d-flex align-items-center justify-content-center bg-light text-muted" style="height:180px">الصورة غير متاحة — يرجى إعادة رفعها</div>
            <div class="card-body p-2">
              <small class="text-truncate d-block fw-bold">${escapeImageText(img.Original_Name)}</small>
              <span class="badge bg-secondary">${escapeImageText(img.Category)}</span>
              ${hasDesign}
            </div>
            <div class="card-footer p-2 d-flex gap-1">
              <a href="/api/orders/agent/images/${img.Image_ID}/file" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary flex-fill">عرض كامل</a>
              <button class="btn btn-sm btn-outline-success flex-fill" onclick="openImageMaterials(${img.Image_ID})">خامات</button>
              ${img.Design_ID ? `<button class="btn btn-sm btn-outline-secondary flex-fill" onclick="unlinkImageFromDesign(${img.Image_ID})"><i class="bi bi-link-45deg"></i> فك الارتباط</button>` : ''}
              <button class="btn btn-sm btn-outline-danger flex-fill" onclick="deleteLibraryImage(${img.Image_ID})"><i class="bi bi-trash"></i> حذف</button>
            </div>
          </div>
        `;
        grid.appendChild(col);
      });
    }

    let uploadPreviewUrls = [];
    function clearUploadPreviews() {
      uploadPreviewUrls.forEach(url => URL.revokeObjectURL(url));
      uploadPreviewUrls = [];
      document.getElementById('uploadImagePreviews').replaceChildren();
    }
    function previewChosenImages() {
      clearUploadPreviews();
      const grid = document.getElementById('uploadImagePreviews');
      Array.from(document.getElementById('uploadImageFiles').files || []).slice(0, 50).forEach(file => {
        const url = URL.createObjectURL(file);
        uploadPreviewUrls.push(url);
        const col = document.createElement('div');
        col.className = 'col-6';
        const image = document.createElement('img');
        image.src = url;
        image.alt = file.name;
        image.className = 'w-100 bg-light rounded';
        image.style.cssText = 'height:120px;object-fit:contain';
        const caption = document.createElement('small');
        caption.className = 'd-block text-break';
        caption.textContent = file.name;
        image.onerror = () => { image.hidden = true; caption.textContent = file.name + ' — لا يمكن معاينة هذه الصورة'; };
        col.append(image, caption);
        grid.appendChild(col);
      });
    }

    async function uploadAdminImages() {
      const form = document.getElementById('uploadImageForm');
      const files = Array.from(document.getElementById('uploadImageFiles').files || []);
      if (!files.length) {
        alert('الرجاء اختيار صورة واحدة على الأقل');
        return;
      }
      if (files.length > 50 || files.some(file => file.size > 10 * 1024 * 1024)) {
        alert('اختر حتى 50 صورة، بحد أقصى 10 ميغابايت للصورة');
        return;
      }
      const button = document.getElementById('uploadAdminImagesButton');
      if (button.disabled) return;
      button.disabled = true;
      button.textContent = 'جارٍ الرفع...';
      const formData = new FormData();
      formData.append('category', document.getElementById('uploadImageCategory').value);
      files.forEach(file => formData.append('images', file, file.name));
      try {
        const res = await fetch('/api/orders/agent/images', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.success) {
          bootstrap.Modal.getInstance(document.getElementById('uploadImageModal')).hide();
          form.reset();
          clearUploadPreviews();
          loadLibraryImages();
        } else { alert(data.error || 'فشل الرفع'); }
      } catch (e) { alert('تعذر الرفع. تحقق من الاتصال وحاول مجدداً'); }
      finally { button.disabled = false; button.textContent = 'رفع'; }
    }

    function deleteLibraryImage(id) {
      if (!confirm('حذف هذه الصورة؟')) return;
      fetch(`/api/orders/agent/images/${id}`, { method: 'DELETE', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json()).then(data => { if (data.success) loadLibraryImages(); else alert(data.error || 'فشل الحذف'); });
    }

    function unlinkImageFromDesign(id) {
      fetch(`/api/orders/agent/images/${id}/link-design`, { method: 'PUT', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify({ design_id: null }) })
        .then(r => r.json()).then(data => { if (data.success) loadLibraryImages(); else alert(data.error || 'فشل فك الارتباط'); });
    }

    // ============ DESIGNS ============
    let designPage = 1;
    async function loadDesigns(page) {
      if (page) designPage = page;
      const search = document.getElementById('designSearch')?.value || '';
      const status = document.getElementById('designStatusFilter')?.value || '';
      const params = new URLSearchParams({ page: designPage, limit: 10 });
      if (search) params.append('search', search);
      if (status) params.append('status', status);
      const d = await fetch('/api/agents/admin/designs?' + params.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json());
      renderDesigns(d.designs || []);
      renderPagination2('designsPagination', d.page, d.pages, loadDesigns);
    }

    function renderDesigns(designs) {
      const tbody = document.getElementById('designsTableBody');
      if (!designs.length) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted">لا توجد تصاميم</td></tr>';
        return;
      }
      tbody.innerHTML = '';
      designs.forEach(d => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>${d.Design_ID}</td>
          <td>${d.Name}</td>
          <td>${d.Category || '-'}</td>
          <td>${d.Material || '-'}</td>
          <td>${d.Thickness || '-'}</td>
          <td>${d.Width ? d.Width + ' ' + (d.Unit || '') : '-'} x ${d.Height ? d.Height + ' ' + (d.Unit || '') : '-'}</td>
          <td>${d.Image_Count || 0}</td>
          <td>${d.Is_Active ? '<span class="badge bg-success">نشط</span>' : '<span class="badge bg-secondary">غير نشط</span>'}</td>
          <td>
            <button class="btn btn-sm btn-outline-primary" onclick="editDesign(${d.Design_ID})"><i class="bi bi-pencil"></i></button>
            <button class="btn btn-sm btn-outline-danger" onclick="deleteDesign(${d.Design_ID})"><i class="bi bi-trash"></i></button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function editDesign(id) { loadDesigns(); }
    function deleteDesign(id) {
      if (!confirm('حذف هذا التصميم؟')) return;
      fetch(`/api/agents/admin/designs/${id}`, { method: 'DELETE', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json()).then(data => { if (data.success) loadDesigns(); else alert(data.error || 'فشل الحذف'); });
    }

    // ============ CUSTOM REQUESTS ============
    let customPage = 1;
    const debouncedCustomSearch = debounce(() => loadCustomRequests(), 300);

    async function loadCustomRequests(page) {
      if (page) customPage = page;
      const status = document.getElementById('customStatusFilter').value;
      const search = document.getElementById('customSearch').value;
      const params = new URLSearchParams({ page: customPage, limit: 20 });
      if (status) params.append('status', status);
      if (search) params.append('search', search);
      const d = await fetch('/api/agents/admin/custom-requests?' + params.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json());
      renderCustomRequests(d.requests || []);
      renderPagination2('customPagination', d.page, d.pages, loadCustomRequests);
    }

    function renderCustomRequests(requests) {
      const tbody = document.getElementById('customRequestsTableBody');
      if (!requests.length) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted">لا توجد طلبات</td></tr>';
        return;
      }
      tbody.innerHTML = '';
      requests.forEach(r => {
        const statusBadges = { 'pending': 'bg-warning text-dark', 'in_progress': 'bg-info', 'completed': 'bg-success', 'cancelled': 'bg-danger' };
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>${r.Custom_Design_ID}</td>
          <td>${r.Agent_Name}</td>
          <td>${r.Client_Name || '-'}</td>
          <td>${r.Name}</td>
          <td><small>${r.Description || '-'}</small></td>
          <td><span class="badge ${statusBadges[r.Status] || 'bg-secondary'}">${r.Status}</span></td>
          <td>${r.Designer_ID ? 'مصمم #' + r.Designer_ID : '-'}</td>
          <td><small>${new Date(r.Created_At).toLocaleDateString('ar-SA')}</small></td>
          <td class="text-nowrap">
            ${r.Status === 'pending' ? `<button class="btn btn-sm btn-success" onclick="openApproveCustomModal(${r.Custom_Design_ID}, ${r.Order_ID || 'null'})"><i class="bi bi-check-lg"></i> موافقة وبدء التنفيذ</button>` : ''}
            ${r.Status === 'in_progress' ? `<button class="btn btn-sm btn-outline-success" onclick="setCustomRequestStatus(${r.Custom_Design_ID}, 'completed')"><i class="bi bi-flag"></i> إتمام</button>` : ''}
            ${r.Status !== 'cancelled' && r.Status !== 'completed' ? `<button class="btn btn-sm btn-outline-danger" onclick="cancelCustomRequest(${r.Custom_Design_ID})"><i class="bi bi-x-lg"></i> إلغاء</button>` : ''}
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    async function setCustomRequestStatus(id, status, extra = {}) {
      const res = await fetch(`/api/agents/admin/custom-requests/${id}/status`, { method: 'PUT', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify({ status, ...extra }) });
      let data = null;
      try { data = await res.json(); } catch { data = null; }
      if (res.ok && data && data.success) { loadCustomRequests(); }
      else { alert((data && data.error) || `فشل التحديث (رمز ${res.status})`); }
    }

    function cancelCustomRequest(id) {
      const reason = prompt('سبب الإلغاء (اختياري):') || '';
      if (reason === null) return;
      setCustomRequestStatus(id, 'cancelled', { notes: reason });
    }

    async function openApproveCustomModal(id, orderId) {
      document.getElementById('approveCustomId').value = id;
      document.getElementById('approveOrderFields').style.display = orderId ? 'none' : 'block';
      // Load designers
      const dsel = document.getElementById('approveDesignerSelect');
      dsel.innerHTML = '<option value="">-- اختر المصمم --</option>';
      try {
        const users = await fetch('/api/users', { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json());
        (Array.isArray(users) ? users : []).filter(u => u.Role === 'Designer').forEach(u => {
          const opt = document.createElement('option');
          opt.value = u.User_ID;
          opt.textContent = `${u.Name} (@${u.Username})`;
          dsel.appendChild(opt);
        });
      } catch (e) { console.error(e); }
      // Load clients only when no linked order
      const csel = document.getElementById('approveClientSelect');
      csel.innerHTML = '<option value="">-- اختر العميل --</option>';
      if (!orderId) {
        try {
          const clients = await fetch('/api/clients/all?search=', { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json());
          (Array.isArray(clients) ? clients : []).forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.Client_ID;
            opt.textContent = `${c.Full_Name}${c.Phone_Number ? ' - ' + c.Phone_Number : ''}`;
            csel.appendChild(opt);
          });
        } catch (e) { console.error(e); }
      }
      new bootstrap.Modal(document.getElementById('approveCustomModal')).show();
    }

    document.getElementById('approveCustomForm').addEventListener('submit', async e => {
      e.preventDefault();
      const id = document.getElementById('approveCustomId').value;
      const designer_id = document.getElementById('approveDesignerSelect').value;
      if (!designer_id) { alert('اختر المصمم أولاً'); return; }
      const orderFieldsVisible = document.getElementById('approveOrderFields').style.display !== 'none';
      const payload = { status: 'in_progress', designer_id: parseInt(designer_id, 10) };
      if (orderFieldsVisible) {
        const client_id = document.getElementById('approveClientSelect').value;
        if (!client_id) { alert('اختر العميل أولاً'); return; }
        payload.client_id = parseInt(client_id, 10);
        payload.machine_type = document.getElementById('approveMachineSelect').value;
      }
      const btn = e.target.querySelector('button[type="submit"]');
      btn.disabled = true;
      try {
        const res = await fetch(`/api/agents/admin/custom-requests/${id}/status`, { method: 'PUT', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify(payload) });
        let data = null;
        try { data = await res.json(); } catch { data = null; }
        if (res.ok && data && data.success) {
          bootstrap.Modal.getInstance(document.getElementById('approveCustomModal')).hide();
          loadCustomRequests();
          alert(data.order_id ? `✅ تمت الموافقة — الطلب #${data.order_id} ظهر الآن عند الرسام` : '✅ تمت الموافقة');
        } else {
          alert((data && data.error) || `فشل التحديث (رمز ${res.status})`);
        }
      } catch (err) { console.error(err); alert('خطأ في الاتصال'); }
      finally { btn.disabled = false; }
    });

    // ============ AGENT CUSTOM ORDERS ============
    let agentCustomPage = 1;
    async function loadAgentCustomOrders(page) {
      if (page) agentCustomPage = page;
      const d = await fetch('/api/agents/admin/agent-custom-orders?page=' + agentCustomPage + '&limit=20', { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json());
      renderAgentCustomOrders(d.files || []);
      renderPagination2('agentCustomPagination', d.page, d.pages, loadAgentCustomOrders);
    }

    function renderAgentCustomOrders(files) {
      const tbody = document.getElementById('agentCustomOrdersTableBody');
      if (!files.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">لا توجد طلبات مخصصة</td></tr>';
        return;
      }
      tbody.innerHTML = '';
      files.forEach(f => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>${f.File_ID}</td>
          <td>${f.Agent_Name}</td>
          <td>${f.Client_Name}</td>
          <td>#${f.Task_ID}</td>
          <td>${f.Original_Name}</td>
          <td><small>${new Date(f.Created_At).toLocaleString('ar-SA')}</small></td>
          <td><button class="btn btn-sm btn-outline-primary" onclick="viewOrder(${f.File_ID})" title="معاينة الملف"><i class="bi bi-eye"></i></button></td>
        `;
        tbody.appendChild(tr);
      });
    }

    function exportAgentCustomOrders() { alert('ميزة التصدير قيد التطوير'); }

    function viewOrder(fileId) {
      window.open(`/api/files/image/${fileId}`, '_blank', 'noopener');
    }

    // ============ PENDING APPROVALS (agent orders) ============
    async function loadPendingApprovals() {
      const tbody = document.getElementById('pendingApprovalsTableBody');
      try {
        const d = await fetch('/api/orders/pending', { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json());
        const orders = d.orders || [];
        updatePendingBadge(orders.length);
        if (!orders.length) {
          tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-4">لا توجد طلبات بانتظار الموافقة 🎉</td></tr>';
          return;
        }
        tbody.innerHTML = '';
        orders.forEach(o => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td><strong>#${o.Task_ID}</strong></td>
            <td>${o.Agent_Name || '-'}</td>
            <td>${o.Client_Name || '-'}</td>
            <td><span class="badge bg-${o.Machine_Type === 'Laser' ? 'danger' : 'success'}">${o.Machine_Type}</span></td>
            <td>${o.Material_Qty || 0}</td>
            <td>${o.Final_Price ? parseFloat(o.Final_Price).toLocaleString() : '-'}</td>
            <td><small class="text-muted">${(o.Notes || '').substring(0, 60)}</small></td>
            <td><small>${o.Created_At ? new Date(o.Created_At).toLocaleString('ar-SA') : ''}</small></td>
            <td class="text-nowrap">
              <button class="btn btn-sm btn-success" onclick="openOrderApproveModal(${o.Task_ID})"><i class="bi bi-check-lg"></i> موافقة</button>
              <button class="btn btn-sm btn-outline-danger" onclick="rejectPendingOrder(${o.Task_ID})"><i class="bi bi-x-lg"></i> رفض</button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      } catch (e) {
        tbody.innerHTML = '<tr><td colspan="9" class="text-center text-danger">فشل التحميل</td></tr>';
      }
    }

    function updatePendingBadge(count) {
      const badge = document.getElementById('pendingCountBadge');
      if (!badge) return;
      badge.textContent = count;
      badge.style.display = count > 0 ? 'inline-block' : 'none';
    }

    async function refreshPendingBadge() {
      try {
        const d = await fetch('/api/orders/pending', { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json());
        updatePendingBadge((d.orders || []).length);
      } catch {}
    }

    async function openOrderApproveModal(taskId) {
      document.getElementById('approveOrderId').value = taskId;
      document.getElementById('approveOrderTitle').textContent = 'الموافقة على الطلب #' + taskId;
      const dsel = document.getElementById('approveOrderDesigner');
      dsel.innerHTML = '<option value="">-- اختر المصمم --</option>';
      try {
        const users = await fetch('/api/users', { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json());
        (Array.isArray(users) ? users : []).filter(u => u.Role === 'Designer').forEach(u => {
          const opt = document.createElement('option');
          opt.value = u.User_ID;
          opt.textContent = `${u.Name} (@${u.Username})`;
          dsel.appendChild(opt);
        });
      } catch (e) { console.error(e); }
      new bootstrap.Modal(document.getElementById('approveOrderModal')).show();
    }

    document.getElementById('approveOrderForm').addEventListener('submit', async e => {
      e.preventDefault();
      const id = document.getElementById('approveOrderId').value;
      const designer_id = document.getElementById('approveOrderDesigner').value;
      if (!designer_id) { alert('اختر المصمم أولاً'); return; }
      const btn = e.target.querySelector('button[type="submit"]');
      btn.disabled = true;
      try {
        const res = await fetch(`/api/orders/${id}/approve`, { method: 'PUT', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify({ action: 'approve', designer_id: parseInt(designer_id, 10) }) });
        let data = null;
        try { data = await res.json(); } catch { data = null; }
        if (res.ok && data && data.success) {
          bootstrap.Modal.getInstance(document.getElementById('approveOrderModal')).hide();
          loadPendingApprovals();
          alert(`✅ تمت الموافقة — الطلب #${id} ظهر الآن عند الرسام`);
        } else {
          alert((data && data.error) || `فشل التحديث (رمز ${res.status})`);
        }
      } catch (err) { console.error(err); alert('خطأ في الاتصال'); }
      finally { btn.disabled = false; }
    });

    async function rejectPendingOrder(taskId) {
      const reason = prompt('سبب الرفض (اختياري):');
      if (reason === null) return;
      const res = await fetch(`/api/orders/${taskId}/approve`, { method: 'PUT', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: JSON.stringify({ action: 'reject', reason }) });
      let data = null;
      try { data = await res.json(); } catch { data = null; }
      if (res.ok && data && data.success) { loadPendingApprovals(); }
      else { alert((data && data.error) || 'فشل الرفض'); }
    }

    // Add tab load handlers
    document.querySelectorAll('[data-tab]').forEach(link => {
      link.addEventListener('click', function(e) {
        const tab = this.dataset.tab;
        if (tab === 'library-images') loadLibraryImages();
        if (tab === 'product-pricing') loadProductPricing();
        if (tab === 'ready-designs') loadDesigns();
        if (tab === 'custom-requests') loadCustomRequests();
        if (tab === 'agent-custom-orders') loadAgentCustomOrders();
        if (tab === 'pending-approvals') loadPendingApprovals();
      });
    });

    // Initial load
    loadAdminStats();
    refreshPendingBadge();
    document.getElementById('uploadAdminImagesButton').addEventListener('click', uploadAdminImages);
    document.getElementById('uploadImageFiles').addEventListener('change', previewChosenImages);
    document.getElementById('productPricingForm').addEventListener('submit', saveProductPricing);

  </script>
<button class="btn-back" title="العودة للخلف" onclick="history.length > 1 ? history.back() : (window.location.href = '/')"><i class="bi bi-arrow-right"></i></button>
</body>
</html>
