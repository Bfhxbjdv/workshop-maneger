<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>تسجيل الدخول - نظام إدارة ورشة التصميم والقص</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
  <div class="container">
    <div class="row justify-content-center align-items-center vh-100">
      <div class="col-md-5">
        <div class="card shadow-lg border-0">
          <div class="card-body p-5">
            <div class="text-center mb-4">
              <img class="login-logo" src="/images/kazanji-group-logo.svg" alt="شعار مجموعة قزنجي">
              <p class="login-brand-name">مجموعة قزنجي</p>
              <h3 class="mt-3">نظام إدارة ورشة التصميم والقص</h3>
              <p class="text-muted">أهلاً بعودتك — سجّل دخولك لمتابعة سير العمل</p>
            </div>
            <% if (typeof error !== 'undefined' && error) { %>
              <div class="alert alert-danger"><%= error %></div>
            <% } %>
            <form method="POST" action="/login">
              <div class="mb-3">
                <label class="form-label">اسم المستخدم</label>
                <input type="text" name="username" class="form-control form-control-lg" required autofocus>
              </div>
              <div class="mb-3">
                <label class="form-label">كلمة المرور</label>
                <input type="password" name="password" class="form-control form-control-lg" required>
              </div>
              <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-arrow-left-circle ms-1"></i> دخول إلى النظام</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
<button class="btn-back" title="العودة للخلف" onclick="history.length > 1 ? history.back() : (window.location.href = '/')"><i class="bi bi-arrow-right"></i></button>
</body>
</html>
