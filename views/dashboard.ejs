<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>لوحة التحكم - نظام إدارة الورشة</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"><i class="bi bi-tools"></i> ورشة التصميم والقص</a>
      <span class="navbar-text text-white"><i class="bi bi-person-circle"></i> <%= user.name %> (<%= user.role %>)</span>
      <div>
        <% if (user.role === 'Admin' || (user.permissions && user.permissions.admin)) { %>
          <a href="/admin" class="btn btn-outline-light btn-sm"><i class="bi bi-gear-wide"></i> لوحة التحكم</a>
        <% } %>
        <% if (user.role === 'Admin' || (user.permissions && user.permissions.expenses)) { %>
          <a href="/expenses" class="btn btn-outline-light btn-sm"><i class="bi bi-cash"></i> المصروفات</a>
        <% } %>
        <a href="/logout" class="btn btn-outline-light btn-sm">خروج</a>
      </div>
    </div>
  </nav>

  <div class="container-fluid mt-4">
    <div class="row">
      <div class="col-md-3 mb-3">
        <div class="card bg-primary text-white">
          <div class="card-body text-center">
            <i class="bi bi-box-seam display-6"></i>
            <h5 class="mt-2" id="totalOrders">-</h5>
            <small>إجمالي الطلبات</small>
          </div>
        </div>
      </div>
      <div class="col-md-3 mb-3">
        <div class="card bg-warning text-dark">
          <div class="card-body text-center">
            <i class="bi bi-clock-history display-6"></i>
            <h5 class="mt-2" id="activeOrders">-</h5>
            <small>طلبات قيد التنفيذ</small>
          </div>
        </div>
      </div>
      <div class="col-md-3 mb-3">
        <div class="card bg-success text-white">
          <div class="card-body text-center">
            <i class="bi bi-people display-6"></i>
            <h5 class="mt-2" id="totalClients">-</h5>
            <small>إجمالي العملاء</small>
          </div>
        </div>
      </div>
      <div class="col-md-3 mb-3">
        <div class="card bg-info text-white">
          <div class="card-body text-center">
            <i class="bi bi-bell display-6"></i>
            <h5 class="mt-2" id="notifCount">-</h5>
            <small>إشعارات</small>
          </div>
        </div>
      </div>
    </div>

    <div class="row mt-4">
      <div class="col-md-8">
        <div class="card">
          <div class="card-header"><i class="bi bi-list-task"></i> آخر الطلبات</div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table table-hover">
                <thead><tr><th>#</th><th>العميل</th><th>الماكينة</th><th>الحالة</th><th>التاريخ</th></tr></thead>
                <tbody id="recentOrders"></tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card">
          <div class="card-header"><i class="bi bi-pie-chart"></i> إحصائيات الحالة</div>
          <div class="card-body">
            <div id="statusChart"></div>
          </div>
        </div>
        <div class="card mt-3">
          <div class="card-header bg-danger text-white"><i class="bi bi-exclamation-triangle"></i> مخزون منخفض</div>
          <div class="card-body" id="lowStock"></div>
        </div>
      </div>
    </div>

    <div class="row mt-3">
      <div class="col-12">
        <div class="card">
          <div class="card-header"><i class="bi bi-speedometer2"></i> روابط سريعة</div>
          <div class="card-body">
            <% if (user.role === 'Admin' || (user.permissions && user.permissions.clients)) { %>
              <a href="/clients" class="btn btn-outline-primary m-1"><i class="bi bi-people"></i> العملاء</a>
            <% } %>
            <% if (user.role === 'Admin' || (user.permissions && user.permissions.inventory)) { %>
              <a href="/inventory" class="btn btn-outline-success m-1"><i class="bi bi-box"></i> المخزون</a>
            <% } %>
            <% if (user.role === 'Admin' || (user.permissions && user.permissions.orders)) { %>
              <a href="/" class="btn btn-outline-info m-1"><i class="bi bi-plus-circle"></i> طلب جديد</a>
            <% } %>
            <% if (user.role === 'Admin' || (user.permissions && user.permissions.invoices)) { %>
              <a href="/invoices" class="btn btn-outline-danger m-1"><i class="bi bi-receipt"></i> الفواتير</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/main.js"></script>
  <script>
    loadStats();
  </script>
<button class="btn-back" title="العودة للخلف" onclick="history.length > 1 ? history.back() : (window.location.href = '/')"><i class="bi bi-arrow-right"></i></button>
</body>
</html>