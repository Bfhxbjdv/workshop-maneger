<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>إنشاء طلب - الوكيل</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
  <style>
    .image-card { transition: all 0.2s; cursor: pointer; }
    .image-card.selected { border: 3px solid #0d6efd; box-shadow: 0 0 0 1px #0d6efd; }
    .image-card img { height: 180px; object-fit: contain; background: #f8f9fa; }
    .qty-input { width: 80px; }
    .sticky-footer { position: sticky; bottom: 0; background: white; border-top: 1px solid #dee2e6; padding: 1rem; z-index: 100; }
    .pricing-card { transition: all 0.2s; cursor: pointer; border: 2px solid transparent; }
    .pricing-card.selected { border-color: #0d6efd; background: #f0f7ff; }
    .price-input { width: 100px; }
  </style>
</head>
<body class="agent-page">
  <nav class="navbar navbar-expand-lg navbar-dark bg-success">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"><i class="bi bi-person-badge"></i> وكيل المبيعات</a>
      <span class="navbar-text text-white"><i class="bi bi-person-circle"></i> <%= user.name %></span>
      <a href="/logout" class="btn btn-outline-light btn-sm ms-auto">خروج</a>
    </div>
  </nav>

  <div class="container-fluid px-4 py-3">
    <div class="row g-3">
      <!-- Left: Order Form -->
      <div class="col-lg-7">
        <div class="card h-100">
          <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-plus-circle"></i> طلب جديد</h5>
          </div>
          <div class="card-body">
            <form id="agentOrderForm">
              <div class="row g-2 mb-3">
                <div class="col-md-6">
                  <label class="form-label fw-bold">العميل <span class="text-danger">*</span></label>
                  <div class="input-group">
                    <input type="text" id="clientSearch" class="form-control" placeholder="اكتب للبحث عن عميل..." autocomplete="off">
                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#newClientModal"><i class="bi bi-plus"></i></button>
                  </div>
                  <div id="clientResults" class="list-group mt-1" style="display:none; max-height:200px; overflow:auto;"></div>
                  <input type="hidden" id="clientId" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label fw-bold">نوع الماكينة <span class="text-danger">*</span></label>
                  <select id="machineType" class="form-select" required>
                    <option value="Laser">ليزر (Laser)</option>
                    <option value="Router">راوتر (Router)</option>
                  </select>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold"><i class="bi bi-images"></i> اختر الصور من أعمالنا <span class="text-danger">*</span></label>
                <div class="form-text">يمكنك اختيار عدة صور لطلب واحد. انقر على الصورة للتحديد/إلغاء التحديد.</div>
                <div id="imagesGrid" class="row g-2 mt-2" style="max-height:400px; overflow:auto;">
                  <div class="col-12 text-center text-muted py-4">جاري تحميل الصور...</div>
                </div>
                <input type="hidden" id="selectedImages" name="Image_IDs">
                <div id="selectedCount" class="mt-2 text-primary fw-bold"></div>
              </div>

              <div class="mb-3">
                <label class="form-label fw-bold"><i class="bi bi-grid-1x2"></i> الكميات (باللوح/Sheet) <span class="text-danger">*</span></label>
                <div class="form-text">أدخل الكمية لكل صورة محددة (باللوح). سيتم إنشاء بند واحد لكل صورة مع كميتها.</div>
                <div id="quantitiesContainer" class="row g-2 mt-2"></div>
              </div>

              <!-- Pricing Section -->
              <div class="mb-3">
                <label class="form-label fw-bold"><i class="bi bi-currency-dollar"></i> اختيار المنتج والسعر <span class="text-danger">*</span></label>
                <div class="form-text">اختر منتجاً من قائمة الأسعار المعتمدة، وسيتم تعبئة السعر الأساسي. يمكنك إضافة عمولتك.</div>
                <div id="pricingSelector" class="row g-2 mt-2" style="max-height:300px; overflow:auto;">
                  <div class="col-12 text-center text-muted py-4">جاري تحميل قائمة الأسعار...</div>
                </div>
                <div class="row g-2 mt-2" id="priceInputs" style="display:none;">
                  <div class="col-md-4">
                    <label class="form-label fw-bold">السعر الأساسي (للوح)</label>
                    <input type="number" id="basePrice" class="form-control" readonly>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label fw-bold">عمولتك (للوح)</label>
                    <input type="number" id="agentCommission" class="form-control" placeholder="مثال: 50" step="0.01" min="0" required>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label fw-bold">السعر النهائي للعميل (للوح)</label>
                    <input type="number" id="finalPrice" class="form-control" readonly>
                  </div>
                </div>
                <input type="hidden" id="selectedPricingId" name="Pricing_ID">
              </div>

              <div class="mb-3">
                <label class="form-label">ملاحظات إضافية</label>
                <textarea id="orderNotes" class="form-control" rows="2" placeholder="أي ملاحظات للطلب..."></textarea>
              </div>
            </form>
          </div>
          <div class="card-footer sticky-footer">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div>
                <div class="text-muted small">سيتم إرسال الطلب للموافقة من الإدارة</div>
                <div class="text-warning small fw-bold" id="submitHint"></div>
              </div>
              <div class="d-flex gap-2">
                <span class="badge bg-success fs-6 px-3 py-2" id="totalPriceBadge" style="display:none;">الإجمالي: <span id="totalPrice">0</span> ريال</span>
                <button type="submit" form="agentOrderForm" class="btn btn-success btn-lg px-4" id="submitBtn" disabled>
                  <i class="bi bi-send"></i> إرسال للاعتماد
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Quick Info & Help -->
      <div class="col-lg-5">
        <div class="card h-100">
          <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-info-circle"></i> تعليمات سريعة</h5>
          </div>
          <div class="card-body">
            <ol class="small mb-4">
              <li>ابحث عن العميل أو أضف عميلاً جديداً</li>
              <li>اختر نوع الماكينة (ليزر/راوتر)</li>
              <li>انقر على الصور التي تريدها من أعمالنا (يمكن اختيار عدة صور)</li>
              <li>أدخل الكمية <strong>باللوح (Sheet)</strong> لكل صورة</li>
              <li>اختر منتجاً من قائمة الأسعار وأضف عمولتك</li>
              <li>اضغط <strong>"إرسال للاعتماد"</strong></li>
            </ol>
            <hr>
            <h6 class="text-success"><i class="bi bi-check-circle"></i> ما سيحدث بعد الإرسال:</h6>
            <ul class="small text-muted mb-0">
              <li>الطلب يذهب للإدارة/المصممين للموافقة</li>
              <li>بعد الموافقة، يتولى المصمم باقي الخطوات</li>
              <li>ستصلك إشعارات بحالة الطلب</li>
            </ul>
          </div>
        </div>

<div class="card mt-3">
    <div class="card-header bg-secondary text-white">
      <h5 class="mb-0"><i class="bi bi-clock-history"></i> آخر طلباتك</h5>
    </div>
    <div class="card-body" style="max-height:300px; overflow:auto;">
      <div id="myRecentOrders" class="list-group list-group-flush">
        <div class="text-center text-muted py-3">جاري التحميل...</div>
      </div>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header bg-warning text-dark">
      <h5 class="mb-0"><i class="bi bi-pencil-square"></i> طلب تصميم مخصص</h5>
    </div>
    <div class="card-body">
      <form id="customDesignForm" enctype="multipart/form-data">
        <div class="mb-2">
          <label class="form-label">اسم التصميم <span class="text-danger">*</span></label>
          <input type="text" id="customDesignName" class="form-control" placeholder="مثال: شعار شركة، كتالوج منتجات، لافتة..." required>
        </div>
        <div class="mb-2">
          <label class="form-label">الوصف والتفاصيل</label>
          <textarea id="customDesignDescription" class="form-control" rows="3" placeholder="وصف التصميم المطلوب، الألوان، الأبعاد، أي مراجع..."></textarea>
        </div>
        <div class="mb-2">
          <label class="form-label">الصور والتصاميم المرجعية (اختياري)</label>
          <input type="file" id="customDesignFiles" name="customDesignFiles" class="form-control" accept="image/*,.pdf,.plt,.dxf,.svg,.eps,.ai,.cdr" multiple>
          <div class="form-text">يمكنك رفع صور مرجعية أو ملفات تصاميم (حتى 10 ملفات، 10MB للملف)</div>
        </div>
        <div class="mb-2">
          <label class="form-label">ربط بطلب موجود (اختياري)</label>
          <select id="customDesignOrderId" class="form-select">
            <option value="">-- بدون ربط بطلب --</option>
          </select>
        </div>
        <button type="submit" class="btn btn-warning w-100"><i class="bi bi-send"></i> إرسال طلب التصميم المخصص</button>
      </form>
    </div>
  </div>
</div>
</div>
</div>
  <div class="modal fade" id="newClientModal" tabindex="-1" aria-labelledby="newClientModalTitle" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form id="newClientForm" novalidate>
          <div class="modal-header"><h5 id="newClientModalTitle">عميل جديد</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
          <div class="modal-body">
            <div class="mb-2"><label class="form-label">الاسم <span class="text-danger">*</span></label><input type="text" id="newClientName" class="form-control" required></div>
            <div class="mb-2"><label class="form-label">رقم الهاتف</label><input type="text" id="newClientPhone" class="form-control"></div>
            <div class="mb-2"><label class="form-label">ملاحظات</label><textarea id="newClientNotes" class="form-control" rows="2"></textarea></div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
            <button type="submit" class="btn btn-primary" id="saveNewClientButton">حفظ واختيار</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Agent Order Page Logic
    let selectedImageIds = [];
    let allImages = [];
    let allClients = [];
    let allPricing = [];
    let selectedPricingId = null;
    let clientsLoaded = false;

    // Load images
    async function loadImages() {
      try {
        const res = await fetch('/api/orders/agent/images', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await res.json();
        allImages = data.images || [];
        renderImages();
      } catch (e) { console.error('loadImages:', e); }
    }

    // Load pricing from admin
    async function loadPricing() {
      try {
        const res = await fetch('/api/orders/agent/pricing', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await res.json();
        allPricing = data.pricing || [];
        renderPricing();
      } catch (e) { console.error('loadPricing:', e); }
    }

    function escapeImageText(value) {
      return String(value || '').replace(/[&<>"']/g, c => ({'&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'}[c]));
    }

    function renderImages() {
      const grid = document.getElementById('imagesGrid');
      if (!allImages.length) {
        grid.innerHTML = '<div class="col-12 text-center text-muted py-4">لا توجد صور مرفوعة. تواصل مع الإدارة لرفع صور الأعمال.</div>';
        return;
      }
      grid.innerHTML = '';
      allImages.forEach(img => {
        const isSelected = selectedImageIds.includes(img.Image_ID);
        const col = document.createElement('div');
        col.className = 'col-6 col-md-4 col-lg-3';
        col.innerHTML = `
          <div class="card h-100 image-card ${isSelected ? 'selected' : ''}" onclick="toggleImage(${img.Image_ID}, this)">
            <img src="/api/orders/agent/images/${img.Image_ID}/file" alt="${escapeImageText(img.Original_Name)}" class="card-img-top" onerror="this.classList.add('d-none'); this.nextElementSibling.classList.remove('d-none')">
            <div class="d-none d-flex align-items-center justify-content-center bg-light text-muted" style="height:180px;">
              الصورة غير متاحة — يرجى إعادة رفعها
            </div>
            <div class="card-body p-2">
              <small class="text-truncate d-block fw-bold">${escapeImageText(img.Original_Name)}</small>
              <span class="badge bg-secondary">${escapeImageText(img.Category)}</span>
              <a href="/api/orders/agent/images/${img.Image_ID}/file" target="_blank" rel="noopener" class="d-block mt-2" onclick="event.stopPropagation()">عرض الصورة كاملة</a>
            </div>
            ${isSelected ? '<div class="position-absolute top-0 end-0 m-2 badge bg-primary rounded-pill"><i class="bi bi-check-lg"></i></div>' : ''}
          </div>
        `;
        grid.appendChild(col);
      });
      updateQuantitiesUI();
    }

    function renderPricing() {
      const container = document.getElementById('pricingSelector');
      if (!allPricing.length) {
        container.innerHTML = '<div class="col-12 text-center text-muted py-4">لا توجد قائمة أسعار متاحة. تواصل مع الإدارة لإضافة منتجات.</div>';
        return;
      }
      container.innerHTML = '';
      allPricing.forEach(p => {
        const isSelected = selectedPricingId === p.Pricing_ID;
        const col = document.createElement('div');
        col.className = 'col-12 col-md-6 col-lg-4';
        col.innerHTML = `
          <div class="card h-100 pricing-card ${isSelected ? 'selected' : ''}" onclick="selectPricing(${p.Pricing_ID}, ${p.Base_Price}, this)">
            <div class="card-body p-3">
              <div class="fw-bold">${p.Product_Name}</div>
              <small class="text-muted">${p.Category} · ${p.Unit}</small>
              ${p.Description ? `<div class="small text-muted mt-1">${p.Description}</div>` : ''}
              <hr class="my-2">
              <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold text-primary">${p.Base_Price.toLocaleString()} ريال/${p.Unit}</span>
                ${isSelected ? '<i class="bi bi-check-circle-fill text-primary fs-5"></i>' : ''}
              </div>
            </div>
          </div>
        `;
        container.appendChild(col);
      });
    }

    function selectPricing(id, basePrice, card) {
      selectedPricingId = id;
      document.getElementById('selectedPricingId').value = id;
      document.getElementById('basePrice').value = basePrice.toLocaleString();
      document.getElementById('priceInputs').style.display = 'flex';
      document.getElementById('agentCommission').value = '';
      document.getElementById('finalPrice').value = '';
      document.querySelectorAll('.pricing-card').forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      calculateTotal();
      updateSubmitButton();
    }

    function calculateTotal() {
      const basePrice = parseFloat(document.getElementById('basePrice').value.replace(/,/g, '')) || 0;
      const commission = parseFloat(document.getElementById('agentCommission').value) || 0;
      const finalPrice = basePrice + commission;
      document.getElementById('finalPrice').value = finalPrice.toLocaleString();
      
      // Calculate total for all selected images
      let totalSheets = 0;
      document.querySelectorAll('.qty-input').forEach(i => {
        totalSheets += parseFloat(i.value) || 0;
      });
      const total = finalPrice * totalSheets;
      document.getElementById('totalPrice').textContent = total.toLocaleString();
      document.getElementById('totalPriceBadge').style.display = totalSheets > 0 ? 'inline-block' : 'none';
    }

    function toggleImage(id, card) {
      if (selectedImageIds.includes(id)) {
        selectedImageIds = selectedImageIds.filter(x => x !== id);
        card.classList.remove('selected');
        const badge = card.querySelector('.badge');
        if (badge) badge.remove();
      } else {
        selectedImageIds.push(id);
        card.classList.add('selected');
        const badge = document.createElement('div');
        badge.className = 'position-absolute top-0 end-0 m-2 badge bg-primary rounded-pill';
        badge.innerHTML = '<i class="bi bi-check-lg"></i>';
        card.appendChild(badge);
      }
      document.getElementById('selectedImages').value = selectedImageIds.join(',');
      updateQuantitiesUI();
      updateSubmitButton();
      calculateTotal();
    }

    function updateQuantitiesUI() {
      const container = document.getElementById('quantitiesContainer');
      const countDiv = document.getElementById('selectedCount');
      if (!selectedImageIds.length) {
        container.innerHTML = '<div class="col-12 text-muted text-center py-3">اختر صوراً أولاً لتحديد الكميات</div>';
        countDiv.textContent = '';
        return;
      }
      countDiv.textContent = `تم اختيار ${selectedImageIds.length} صورة — حدد الكمية لكل منها:`;
      container.innerHTML = '';
      selectedImageIds.forEach(id => {
        const img = allImages.find(i => i.Image_ID === id);
        if (!img) return;
        const col = document.createElement('div');
        col.className = 'col-12 col-md-6';
        col.innerHTML = `
          <div class="card border-secondary">
            <div class="card-body p-2 d-flex align-items-center gap-2">
              <img src="/api/orders/agent/images/${id}/file" style="width:50px;height:50px;object-fit:contain;border-radius:4px" onerror="this.style.display='none'">
              <div class="flex-grow-1">
                <small class="fw-bold">${img.Original_Name}</small>
                <small class="text-muted d-block">${img.Category}</small>
              </div>
              <input type="number" class="form-control form-control-sm qty-input" data-image-id="${id}" placeholder="لوح" step="0.1" min="0.1" required>
            </div>
          </div>
        `;
        container.appendChild(col);
      });
      calculateTotal();
    }

    function updateSubmitButton() {
      const btn = document.getElementById('submitBtn');
      const hint = document.getElementById('submitHint');
      const hasClient = !!document.getElementById('clientId').value;
      const hasImages = selectedImageIds.length > 0;
      const qtyInputs = Array.from(document.querySelectorAll('.qty-input'));
      const hasQtys = hasImages && qtyInputs.length > 0 && qtyInputs.every(i => i.value && parseFloat(i.value) > 0);
      const hasPricing = !!(selectedPricingId && document.getElementById('agentCommission').value && document.getElementById('finalPrice').value);
      const ok = hasClient && hasImages && hasQtys && hasPricing;
      btn.disabled = !ok;
      if (hint) {
        if (ok) { hint.textContent = ''; return; }
        const missing = [];
        if (!hasClient) missing.push('اختر العميل');
        if (!hasImages) missing.push('اختر صورة واحدة على الأقل');
        else if (!hasQtys) missing.push('أدخل الكمية (باللوح) لكل صورة');
        if (!hasPricing) missing.push('اختر المنتج وأدخل عمولتك');
        hint.textContent = 'متبقٍّ: ' + missing.join('، ');
      }
    }

    // Client search
    async function searchClients() {
      const q = document.getElementById('clientSearch').value.trim();
      const results = document.getElementById('clientResults');
      if (q.length < 2) { results.style.display = 'none'; return; }
      try {
        const res = await fetch('/api/clients?search=' + encodeURIComponent(q), { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await res.json();
        const clients = data.clients || data;
        results.innerHTML = '';
        if (!clients.length) {
          results.innerHTML = '<div class="list-group-item text-muted">لا يوجد نتائج</div>';
        } else {
          clients.forEach(c => {
            const item = document.createElement('button');
            item.type = 'button';
            item.className = 'list-group-item list-group-item-action';
            item.textContent = c.Full_Name + (c.Phone_Number ? ' - ' + c.Phone_Number : '');
            item.onclick = () => selectClient(c.Client_ID, c.Full_Name);
            results.appendChild(item);
          });
        }
        results.style.display = 'block';
      } catch (e) { console.error(e); }
    }

    function selectClient(id, name) {
      document.getElementById('clientId').value = id;
      document.getElementById('clientSearch').value = name;
      document.getElementById('clientResults').style.display = 'none';
      updateSubmitButton();
    }

    function clearStuckModalBackdrop() {
      if (document.querySelector('.modal.show')) return;
      document.body.classList.remove('modal-open');
      document.body.style.removeProperty('padding-right');
      document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
    }

    function closeNewClientModal() {
      const modalElement = document.getElementById('newClientModal');
      const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
      modalElement.addEventListener('hidden.bs.modal', clearStuckModalBackdrop, { once: true });
      modal.hide();
      // Bootstrap normally removes this itself. This only covers an interrupted
      // animation, which was leaving the page unusable after saving a client.
      window.setTimeout(clearStuckModalBackdrop, 500);
    }

    async function addNewClient(event) {
      event?.preventDefault();
      const name = document.getElementById('newClientName').value.trim();
      const phone = document.getElementById('newClientPhone').value.trim();
      const notes = document.getElementById('newClientNotes').value.trim();
      if (!name) return alert('الاسم مطلوب');
      const button = document.getElementById('saveNewClientButton');
      if (button.disabled) return;
      button.disabled = true;
      button.textContent = 'جارٍ الحفظ...';
      try {
        const response = await fetch('/api/clients', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ Full_Name: name, Phone_Number: phone, Notes: notes })
        });
        const data = await response.json();
        if (data.Client_ID) {
          selectClient(data.Client_ID, name);
          closeNewClientModal();
          document.getElementById('newClientName').value = '';
          document.getElementById('newClientPhone').value = '';
          document.getElementById('newClientNotes').value = '';
        } else alert(data.error || 'فشل الإضافة');
      } catch (e) { console.error(e); alert('تعذر حفظ العميل. تحقق من الاتصال وحاول مجدداً'); }
      finally { button.disabled = false; button.textContent = 'حفظ واختيار'; }
    }

    // Load recent orders
    async function loadMyOrders() {
      try {
        const res = await fetch('/api/orders?limit=10&sort=newest', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await res.json();
        // The API already scopes to this agent's own orders — no client filter needed.
        const orders = data.orders || data || [];
        const container = document.getElementById('myRecentOrders');
        if (!orders.length) {
          container.innerHTML = '<div class="text-center text-muted py-3">لا توجد طلبات سابقة</div>';
          return;
        }
        container.innerHTML = '';
        orders.forEach(o => {
          const badge = o.Status === 'بانتظار الموافقة' ? 'bg-warning text-dark'
            : o.Approval_Status === 'rejected' ? 'bg-danger'
            : o.Status === 'تم التسليم' ? 'bg-success' : 'bg-primary';
          const item = document.createElement('div');
          item.className = 'list-group-item d-flex justify-content-between align-items-center';
          item.innerHTML = `
            <div>
              <div class="fw-bold">#${o.Task_ID} - ${o.Client_Name || 'عميل'}</div>
              <small class="text-muted">${o.Machine_Type} · ${o.Material_Qty || 0} لوح · ${o.Final_Price || 0} ريال/لوح</small>
            </div>
            <span class="badge ${badge}">${o.Status}</span>
          `;
          container.appendChild(item);
        });
      } catch (e) { console.error(e); }
    }

    // Form submit
    document.getElementById('agentOrderForm').addEventListener('submit', async e => {
      e.preventDefault();
      const clientId = document.getElementById('clientId').value;
      const machineType = document.getElementById('machineType').value;
      const notes = document.getElementById('orderNotes').value;
      const qtys = {};
      document.querySelectorAll('.qty-input').forEach(i => { qtys[i.dataset.imageId] = parseFloat(i.value); });

      const basePrice = parseFloat(document.getElementById('basePrice').value.replace(/,/g, '')) || 0;
      const agentCommission = parseFloat(document.getElementById('agentCommission').value) || 0;
      const finalPrice = parseFloat(document.getElementById('finalPrice').value.replace(/,/g, '')) || 0;

      const payload = {
        Client_ID: parseInt(clientId),
        Machine_Type: machineType,
        Notes: notes,
        Image_IDs: selectedImageIds,
        Quantities: qtys,
        Pricing_ID: selectedPricingId,
        Agent_Price: basePrice,
        Agent_Commission: agentCommission,
        Final_Price: finalPrice
      };

      document.getElementById('submitBtn').disabled = true;
      document.getElementById('submitBtn').innerHTML = '<span class="spinner-border spinner-border-sm"></span> جاري الإرسال...';

      try {
        const res = await fetch('/api/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.Task_ID) {
          alert('✅ تم إرسال الطلب للاعتماد بنجاح!\nرقم الطلب: #' + data.Task_ID);
          document.getElementById('agentOrderForm').reset();
          selectedImageIds = [];
          selectedPricingId = null;
          document.getElementById('selectedImages').value = '';
          document.getElementById('selectedPricingId').value = '';
          document.getElementById('priceInputs').style.display = 'none';
          document.getElementById('totalPriceBadge').style.display = 'none';
          document.querySelectorAll('.image-card').forEach(c => c.classList.remove('selected'));
          document.querySelectorAll('.image-card .badge').forEach(b => b.remove());
          document.querySelectorAll('.pricing-card').forEach(c => c.classList.remove('selected'));
          renderImages();
          renderPricing();
          loadMyOrders();
        } else {
          alert(data.error || 'فشل الإرسال');
        }
      } catch (e) { console.error(e); alert('خطأ في الاتصال'); }
      finally {
        document.getElementById('submitBtn').disabled = false;
        document.getElementById('submitBtn').innerHTML = '<i class="bi bi-send"></i> إرسال للاعتماد';
        updateSubmitButton();
      }
    });

    // Event listeners
    document.getElementById('clientSearch').addEventListener('input', () => {
      clearTimeout(window.clientSearchTimer);
      window.clientSearchTimer = setTimeout(searchClients, 300);
    });
    document.addEventListener('click', e => {
      if (!e.target.closest('#clientSearch') && !e.target.closest('#clientResults')) {
        document.getElementById('clientResults').style.display = 'none';
      }
    });
    document.getElementById('agentCommission').addEventListener('input', () => { calculateTotal(); updateSubmitButton(); });
    // Delegated: quantity inputs are re-created every time images are toggled
    document.getElementById('quantitiesContainer').addEventListener('input', e => {
      if (e.target && e.target.classList && e.target.classList.contains('qty-input')) { updateSubmitButton(); calculateTotal(); }
    });

    // Init
    document.getElementById('newClientForm').addEventListener('submit', addNewClient);
    document.getElementById('newClientModal').addEventListener('hidden.bs.modal', clearStuckModalBackdrop);
    loadImages();
    loadPricing();
    loadMyOrders();
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Custom Design Request Logic (inline card form)
    document.getElementById('customDesignForm').addEventListener('submit', async e => {
      e.preventDefault();
      const form = e.target;
      const btn = form.querySelector('button[type="submit"]');
      const nameInput = document.getElementById('customDesignName');
      const name = (nameInput.value || '').trim();
      if (!name) { alert('اسم التصميم مطلوب'); nameInput.focus(); return; }
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> جاري الإرسال...';

      const formData = new FormData();
      formData.append('name', name);
      formData.append('description', (document.getElementById('customDesignDescription').value || '').trim());
      formData.append('order_id', document.getElementById('customDesignOrderId').value || '');
      const files = document.getElementById('customDesignFiles').files;
      for (let i = 0; i < files.length && i < 10; i++) {
        formData.append('customDesignFiles', files[i]);
      }

      try {
        const res = await fetch('/api/agents/my/custom-design', {
          method: 'POST',
          body: formData,
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        let data = null;
        try { data = await res.json(); } catch { data = null; }
        if (res.ok && data && data.success) {
          alert('✅ تم إرسال طلب التصميم المخصص بنجاح!');
          form.reset();
          loadMyCustomDesigns();
        } else {
          alert((data && data.error) || `فشل الإرسال (رمز ${res.status})`);
        }
      } catch (err) { console.error(err); alert('خطأ في الاتصال'); }
      finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-send"></i> إرسال طلب التصميم المخصص';
      }
    });

    async function loadOrderIdsForCustomDesign() {
      try {
        const res = await fetch('/api/agents/my/orders?limit=50', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        if (!res.ok) return;
        const data = await res.json();
        const select = document.getElementById('customDesignOrderId');
        if (!select) return;
        select.innerHTML = '<option value="">-- بدون ربط بطلب --</option>';
        const orders = data.orders || data || [];
        orders.forEach(o => {
          const opt = document.createElement('option');
          opt.value = o.Task_ID;
          opt.textContent = `#${o.Task_ID} - ${o.Client_Name || 'عميل'} (${o.Machine_Type || ''}) - ${o.Status || ''}`;
          select.appendChild(opt);
        });
      } catch (e) { console.error(e); }
    }

    async function loadMyCustomDesigns() {
      try {
        const res = await fetch('/api/agents/my/custom-designs', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        if (!res.ok) return;
        await res.json();
      } catch (e) { console.error(e); }
    }

    loadOrderIdsForCustomDesign();
    loadMyCustomDesigns();
  </script>
<button class="btn-back" title="العودة للخلف" onclick="history.length > 1 ? history.back() : (window.location.href = '/')"><i class="bi bi-arrow-right"></i></button>
</body>
</html>
