<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>إدارة العملاء</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"><i class="bi bi-people"></i> إدارة العملاء</a>
      <div>
        <a href="/" class="btn btn-outline-light btn-sm">الرئيسية</a>
        <a href="/logout" class="btn btn-outline-light btn-sm">خروج</a>
      </div>
    </div>
  </nav>
  <div class="container-fluid mt-3">
    <div class="row mb-3">
      <div class="col-md-6">
        <input type="text" id="searchClient" class="form-control" placeholder="بحث عن عميل...">
      </div>
      <div class="col-md-2">
        <button class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#clientModal" onclick="resetClientForm()"><i class="bi bi-plus"></i> إضافة عميل</button>
      </div>
    </div>
    <div class="card">
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead><tr><th>#</th><th>الاسم</th><th>الهاتف</th><th>التقييم</th><th>إجمالي الإنفاق</th><th>ملاحظات</th><th>عرض</th><th>خيارات</th></tr></thead>
            <tbody id="clientsTableBody"></tbody>
          </table>
        </div>
        <nav><ul class="pagination" id="clientsPagination"></ul></nav>
      </div>
    </div>
  </div>

  <div class="modal fade" id="clientModal">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header"><h5>بيانات العميل</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <input type="hidden" id="editClientId">
          <div class="mb-2"><label class="form-label">الاسم</label><input type="text" id="clientName" class="form-control"></div>
          <div class="mb-2"><label class="form-label">رقم الهاتف</label><input type="text" id="clientPhone" class="form-control"></div>
          <div class="mb-2"><label class="form-label">التقييم</label><select id="clientRating" class="form-select"><option value="1">1</option><option value="2">2</option><option value="3" selected>3</option><option value="4">4</option><option value="5">5</option></select></div>
          <div class="mb-2"><label class="form-label">ملاحظات</label><textarea id="clientNotes" class="form-control"></textarea></div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-primary" onclick="saveClient()">حفظ</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/main.js"></script>
  <script>setTimeout(loadClients, 100);</script>
</body>
</html>