<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>إدارة المستخدمين</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"><i class="bi bi-shield-lock"></i> إدارة المستخدمين</a>
      <a href="/" class="btn btn-outline-light btn-sm">الرئيسية</a>
    </div>
  </nav>
  <div class="container-fluid mt-3">
    <button class="btn btn-dark mb-3" data-bs-toggle="modal" data-bs-target="#userModal"><i class="bi bi-person-plus"></i> إضافة مستخدم</button>
    <div class="card">
      <div class="card-body">
        <table class="table table-hover">
          <thead><tr><th>#</th><th>الاسم</th><th>اسم المستخدم</th><th>الصلاحية</th><th>تاريخ التسجيل</th><th>خيارات</th></tr></thead>
          <tbody id="usersTableBody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="modal fade" id="userModal">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header"><h5>بيانات المستخدم</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <input type="hidden" id="editUserId">
          <div class="mb-2"><label>الاسم</label><input type="text" id="userName" class="form-control"></div>
          <div class="mb-2"><label>اسم المستخدم</label><input type="text" id="userUsername" class="form-control"></div>
          <div class="mb-2"><label>كلمة المرور</label><input type="password" id="userPassword" class="form-control" placeholder="اترك فارغاً إذا لا تريد التغيير"></div>
          <div class="mb-2"><label>الصلاحية</label>
            <select id="userRole" class="form-select">
              <option value="Admin">مدير</option>
              <option value="Designer">مصمم</option>
              <option value="Laser_Op">عامل ليزر</option>
              <option value="Router_Op">عامل راوتر</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-primary" onclick="saveUser()">حفظ</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>