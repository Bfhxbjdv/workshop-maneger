<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>إدارة المستخدمين</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/"><i class="bi bi-shield-lock"></i> إدارة المستخدمين</a>
      <a href="/" class="btn btn-outline-light btn-sm">الرئيسية</a>
    </div>
  </nav>
  <div class="container-fluid mt-3">
    <div class="row mb-3">
      <div class="col">
        <button class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#userModal" onclick="resetUserForm()">
          <i class="bi bi-person-plus"></i> إضافة مستخدم جديد
        </button>
      </div>
    </div>

    <div class="card">
      <div class="card-header bg-dark text-white">
        <i class="bi bi-people"></i> قائمة المستخدمين
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>#</th>
                <th>الاسم</th>
                <th>اسم المستخدم</th>
                <th>الصلاحية</th>
                <th>الصلاحيات المخصصة</th>
                <th>تاريخ التسجيل</th>
                <th>خيارات</th>
              </tr>
            </thead>
            <tbody id="usersTableBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="userModal">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-dark text-white">
          <h5 class="modal-title"><i class="bi bi-person"></i> بيانات المستخدم</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="editUserId">
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">الاسم الكامل</label>
                <input type="text" id="userName" class="form-control" placeholder="أدخل الاسم">
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">اسم المستخدم</label>
                <input type="text" id="userUsername" class="form-control" placeholder="أدخل اسم المستخدم">
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">كلمة المرور</label>
                <input type="password" id="userPassword" class="form-control" placeholder="اترك فارغاً إذا لا تريد التغيير">
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label">الصلاحية الأساسية</label>
                <select id="userRole" class="form-select" onchange="togglePermissions()">
                  <option value="Admin">مدير</option>
                  <option value="Designer">مصمم</option>
                  <option value="Laser_Op">عامل ليزر</option>
                  <option value="Router_Op">عامل راوتر</option>
                  <option value="Agent">وكيل</option>
                  <option value="Custom">صلاحيات مخصصة</option>
                </select>
              </div>
            </div>
          </div>

          <div id="customPermissions" style="display: none;">
            <div class="card bg-light">
              <div class="card-header">
                <i class="bi bi-key"></i> الصلاحيات المخصصة
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-6">
                    <div class="form-check form-switch mb-2">
                      <input class="form-check-input" type="checkbox" id="perm_dashboard">
                      <label class="form-check-label" for="perm_dashboard">لوحة التحكم</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                      <input class="form-check-input" type="checkbox" id="perm_clients">
                      <label class="form-check-label" for="perm_clients">إدارة العملاء</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                      <input class="form-check-input" type="checkbox" id="perm_orders">
                      <label class="form-check-label" for="perm_orders">إدارة الطلبات</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                      <input class="form-check-input" type="checkbox" id="perm_inventory">
                      <label class="form-check-label" for="perm_inventory">إدارة المخزون</label>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="form-check form-switch mb-2">
                      <input class="form-check-input" type="checkbox" id="perm_invoices">
                      <label class="form-check-label" for="perm_invoices">الفواتير</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                      <input class="form-check-input" type="checkbox" id="perm_expenses">
                      <label class="form-check-label" for="perm_expenses">المصروفات</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                      <input class="form-check-input" type="checkbox" id="perm_admin">
                      <label class="form-check-label" for="perm_admin">لوحة تحكم المدير</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                      <input class="form-check-input" type="checkbox" id="perm_users">
                      <label class="form-check-label" for="perm_users">إدارة المستخدمين</label>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
          <button class="btn btn-primary" onclick="saveUser()"><i class="bi bi-check-lg"></i> حفظ</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/main.js"></script>
  <script>
    function resetUserForm() {
      document.getElementById('editUserId').value = '';
      document.getElementById('userName').value = '';
      document.getElementById('userUsername').value = '';
      document.getElementById('userPassword').value = '';
      document.getElementById('userRole').value = 'Designer';
      document.getElementById('userPassword').placeholder = '';
      togglePermissions();
      clearPermissions();
    }

    function togglePermissions() {
      const role = document.getElementById('userRole').value;
      const permsDiv = document.getElementById('customPermissions');
      // Agent has fixed permissions (orders, clients), no custom perms needed
      permsDiv.style.display = role === 'Custom' ? 'block' : 'none';
    }

    function clearPermissions() {
      document.getElementById('perm_dashboard').checked = false;
      document.getElementById('perm_clients').checked = false;
      document.getElementById('perm_orders').checked = false;
      document.getElementById('perm_inventory').checked = false;
      document.getElementById('perm_invoices').checked = false;
      document.getElementById('perm_expenses').checked = false;
      document.getElementById('perm_admin').checked = false;
      document.getElementById('perm_users').checked = false;
    }

    function getPermissions() {
      return {
        dashboard: document.getElementById('perm_dashboard').checked,
        clients: document.getElementById('perm_clients').checked,
        orders: document.getElementById('perm_orders').checked,
        inventory: document.getElementById('perm_inventory').checked,
        invoices: document.getElementById('perm_invoices').checked,
        expenses: document.getElementById('perm_expenses').checked,
        admin: document.getElementById('perm_admin').checked,
        users: document.getElementById('perm_users').checked
      };
    }

    function setPermissions(perms) {
      try {
        const p = typeof perms === 'string' ? JSON.parse(perms) : perms;
        document.getElementById('perm_dashboard').checked = p.dashboard || false;
        document.getElementById('perm_clients').checked = p.clients || false;
        document.getElementById('perm_orders').checked = p.orders || false;
        document.getElementById('perm_inventory').checked = p.inventory || false;
        document.getElementById('perm_invoices').checked = p.invoices || false;
        document.getElementById('perm_expenses').checked = p.expenses || false;
        document.getElementById('perm_admin').checked = p.admin || false;
        document.getElementById('perm_users').checked = p.users || false;
      } catch {}
    }

    async function editUser(id) {
      const res = await fetch('/api/users');
      const users = await res.json();
      const user = users.find(u => u.User_ID === id);
      if (!user) return;

      document.getElementById('editUserId').value = user.User_ID;
      document.getElementById('userName').value = user.Name;
      document.getElementById('userUsername').value = user.Username;
      document.getElementById('userPassword').value = '';
      document.getElementById('userPassword').placeholder = 'اترك فارغاً إذا لا تريد التغيير';
      document.getElementById('userRole').value = user.Role;
      setPermissions(user.Permissions);
      togglePermissions();
      new bootstrap.Modal(document.getElementById('userModal')).show();
    }
  </script>
<button class="btn-back" title="العودة للخلف" onclick="history.length > 1 ? history.back() : (window.location.href = '/')"><i class="bi bi-arrow-right"></i></button>
</body>
</html>
